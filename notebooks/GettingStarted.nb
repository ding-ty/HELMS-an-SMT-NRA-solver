Notebook[{Cell["HELMS: a CNF polynomial example", "Title"], 
  Cell["Keep this notebook in the repository's notebooks directory. Evaluate \
the three input cells in order with Shift+Enter.", "Text"], 
  Cell["1. Load HELMS", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"artifactRoot", "=", 
        RowBox[{"If", "[", RowBox[{RowBox[{"$FrontEnd", "===", "Null"}], ",", 
            RowBox[{"DirectoryName", "[", RowBox[{"DirectoryName", "[", 
                "$InputFileName", "]"}], "]"}], ",", 
            RowBox[{"ParentDirectory", "[", RowBox[{"NotebookDirectory", "[", 
                "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"Get", "[", RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", RowBox[{"artifactRoot", ",", "\"solvers\"", ",", 
              "\"paper solvers\"", ",", "\"HELMS.wl\""}], "}"}], "]"}], 
        "]"}], ";"}]], "Input"], Cell["2. Define a CNF polynomial formula", 
   "Section"], Cell["Use exact integer or rational coefficients and strict \
polynomial inequalities. The || operator joins alternatives in each clause; \
&& requires both clauses, giving conjunctive normal form (CNF).", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{"Clear", "[", RowBox[{"x", ",", "y"}], "]"}], 
      ";", RowBox[{"variables", "=", RowBox[{"{", RowBox[{"x", ",", "y"}], 
          "}"}]}], ";", RowBox[{"formula", "=", 
        RowBox[{RowBox[{"(", RowBox[{RowBox[{RowBox[{SuperscriptBox["x", 
                   "2"], "+", SuperscriptBox["y", "2"]}], "<", "1"}], "||", 
              RowBox[{RowBox[{"x", "-", "y"}], ">", "2"}]}], ")"}], "&&", 
          RowBox[{"(", RowBox[{RowBox[{"x", ">", "0"}], "||", 
              RowBox[{"y", ">", "0"}]}], ")"}]}]}], ";", "formula"}]], 
   "Input"], Cell["3. Solve", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"SeedRandom", "[", "314159", "]"}], ";", 
      RowBox[{"answer", "=", RowBox[{"HELMS`Solve", "[", 
          RowBox[{"formula", ",", "variables"}], "]"}]}], ";", "answer"}]], "Input"], 
  Cell["A SAT result includes an exact satisfying assignment. Change the \
formula and variable list above to solve another problem. To use 2D-LS, load \
solvers/paper solvers/2DLS.wl and call TwoDLS`Solve with the same arguments."\
, "Text"]}, WindowTitle -> "HELMS CNF example"]
