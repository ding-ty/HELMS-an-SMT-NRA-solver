(* HELMS 1.0 -- self-contained hybrid solver for exact strict polynomial CNF.
   Copy this file alone and load it with Get. No companion solver, component,
   configuration file or standalone 2D-LS package is required.
   Use HELMS`Solve[formula, variables] or
       HELMS`Solve[polynomials, pairCNF, variables].
   Optional arguments: "TimeLimit" -> seconds, "Config" -> <|...|>.
   The exact local-search, MCSAT and OpenCAD stages are included below. *)

HELMS`Private`$LoadingContextPath = $ContextPath;
$ContextPath = {"System`"};

(* Generated by runner/build_mcsat_core.py from the hash-bound HELMS source.
   Projection, sample-cell learning, conflict intervals and backtracking are retained.
   No Reduce, Resolve, CAD or other complete fallback is invoked in this package. *)
BeginPackage["HELMSMCSAT`"];
MCSATSolver::usage="MCSATSolver[signedClauses,polynomials,variables,optionsAssociation] runs the retained HELMS MCSAT calculus with exact model checks.";
Begin["`Private`"];

exactRealQ[v_] := FreeQ[v, _Real] && TrueQ[Element[v, Reals]] && TrueQ[Element[v, Algebraics]];

safeAssignment[vars_, proposal_] := Module[{result=<||>},
  If[AssociationQ[proposal],
    Scan[If[KeyExistsQ[proposal,#] && exactRealQ[proposal[#]],result[#]=proposal[#]]&,vars]];
  result
];

modelQ[clauses_, polys_, vars_, assignment_] := AssociationQ[assignment] &&
  And@@(KeyExistsQ[assignment,#]& /@ vars) &&
  And@@(exactRealQ[assignment[#]]& /@ vars) &&
  TrueQ[And@@Map[Function[c,Or@@Map[Function[lit,
    If[lit>0,(polys[[lit]]/.assignment)>0,(polys[[-lit]]/.assignment)<0]],c]],clauses]];

MCSATSolver[clauses_,polys_,vars_,opts_:<||>] := Block[{$MaxExtraPrecision=Infinity}, Module[
  {tag=Unique["mcsatFailure"], answer, normalized, kept, ids, idMap, cnf, fs,
   constants, initial, ruleCoefficients, messageSeen=False},
  Catch[
    If[!ListQ[clauses] || !AllTrue[clauses,ListQ] || !ListQ[polys] || !ListQ[vars] ||
       !AssociationQ[opts] || !DuplicateFreeQ[vars] || !AllTrue[vars,MatchQ[#,_Symbol]&],
       Return[{"unknown","MCSAT:invalid-input"}]];
    If[!AllTrue[Flatten[clauses],IntegerQ[#] && #!=0 && Abs[#]<=Length[polys]&],
       Return[{"unknown","MCSAT:invalid-literal-index"}]];
    If[!AllTrue[polys,PolynomialQ[#,vars]&] || !FreeQ[polys,_Real] ||
       Complement[Variables[polys],vars]=!={},Return[{"unknown","MCSAT:unsupported-polynomial"}]];
    ruleCoefficients=If[vars==={},polys,Flatten[(Last /@ CoefficientRules[#,vars])& /@ polys]];
    If[!AllTrue[ruleCoefficients,IntegerQ[#] || Head[#]===Rational&],
       Return[{"unknown","MCSAT:nonrational-coefficient"}]];
    initial=Join[AssociationThread[vars,ConstantArray[0,Length[vars]]],
      safeAssignment[vars,Lookup[opts,"InitialAssignment",<||>]]];
    normalized=DeleteDuplicates /@ clauses;
    cnf={};
    Scan[Function[c,
      If[AnyTrue[c,Function[l,Variables[polys[[Abs[l]]]]==={} &&
          TrueQ[If[l>0,polys[[l]]>0,polys[[-l]]<0]]]],Null,
        kept=Select[c,Variables[polys[[Abs[#]]]]=!={}&];
        If[kept==={},Throw[{"unsat","MCSAT:constant"},tag]];
        AppendTo[cnf,kept]]],normalized];
    If[cnf==={},Return[{"sat","MCSAT:constant",initial}]];
    ids=Union[Abs[Flatten[cnf]]];
    idMap=AssociationThread[ids,Range[Length[ids]]];
    cnf=Map[Sign[#]*idMap[Abs[#]]&,cnf,{2}];
    fs=Expand /@ polys[[ids]];
    answer=Check[runCore[cnf,fs,vars,opts],messageSeen=True;$Failed];
    If[messageSeen || answer===$Failed,Return[{"unknown","MCSAT:runtime-message"}]];
    If[!ListQ[answer] || Length[answer]<2,Return[{"unknown","MCSAT:invalid-state"}]];
    Switch[answer[[1]],
      "sat",If[Length[answer]==3 && modelQ[clauses,polys,vars,answer[[3]]],
        answer,{"unknown","MCSAT:invalid-model"}],
      "unsat",answer,
      "switch",If[Length[answer]==3 && AssociationQ[answer[[3]]],answer,{"unknown","MCSAT:invalid-switch"}],
      "unknown",answer,
      _,{"unknown","MCSAT:invalid-state"}],
    tag]
]];

Pc[A_,x_]:=Flatten[CoefficientList[A,x]];
Pc[A_List,M_Association ,x_]:=
Module[{p1={},p2={},c,i,j},
    For[i=1,i<=Length[A],++i,
        c=CoefficientList[A[[i]],x];
        For[j=Length[c],j>0,--j,
            AppendTo[p1,c[[j]]];
            If[UnsameQ[c[[j]]/.M,0],Break[]];
        ];
        If[SameQ[p1[[-1]]/.M,0],AppendTo[p2,A[[i]]]];
    ];
    Return[{p1,p2}];
];
Pr[A_List,x_]:=Map[Apply[Resultant[#1,#2,x]&],Subsets[A,{2}]];
Pr[A_List,B_List,x_]:=Map[Apply[Resultant[#1,#2,x]&],Select[Tuples[{A,B}],UnsameQ[#[[1]],#[[2]]]&]];
Pmc[A_List,M_Association,x_]:=
Module[{A1,B,M1=KeyDrop[M,x],p1},
    A1=DeleteDuplicates[Flatten[Map[FactorList,A][[All,All,1]]]];
    B=Select[A1,Not[MemberQ[Variables[#],x]]&];
    A1=Select[A1,MemberQ[Variables[#],x]&];
    p1=Pc[A1,M1,x][[1]];
    A1=Select[A1,MemberQ[Variables[#/.M1],x]&];
    Return[DeleteDuplicates[Flatten[{B,p1,Discriminant[A1,x],Pr[A1,x]}]]];
];
Pmc[A_List,x_]:=
Module[{A1,B},
    A1=DeleteDuplicates[Flatten[Map[FactorList,A][[All,All,1]]]];
    B=Select[A1,Not[MemberQ[Variables[#],x]]&];
    A1=Select[A1,MemberQ[Variables[#],x]&];
    Return[DeleteDuplicates[Flatten[{B,Pc[A1,x],Discriminant[A1,x],Pr[A1,x]}]]];
];
GetSampleInterval[A_List,M_Association,x_]:=
Module[{A1=DeleteDuplicates[Flatten[Map[FactorList,A][[All,All,1]]]],B,A0,A2,x0=M[x],
        M1=KeyDrop[M,x],rootintervals,numroot,tmpindex,
        rightindex,rightrootindex,leftindex,leftrootindex},
    B=Select[A1,(Not[MemberQ[Variables[#],x]] && UnsameQ[Variables[#],{}])&];
    A1=Select[A1,MemberQ[Variables[#],x]&];
    A0=Select[A1,MemberQ[Variables[#/.M1],x]&];
    If[Length[A0]==0,Return[{{},{B,A1,A0,{{},{}}}}]];
    rootintervals=RootIntervals[A0/.M1];
    numroot=Length[rootintervals[[1]]];
    If[numroot==0,Return[{{},{B,A1,A0,{{},{}}}}]];
    A2=A0[[DeleteDuplicates[Flatten[rootintervals[[2]]]]]];
    tmpindex=Max[LengthWhile[rootintervals[[1]],(x0>#[[1]]|| #[[2]]==x0 )&],1];
    rightindex=rootintervals[[2,tmpindex,1]];
    rightrootindex=Plus@@Map[Count[#,rightindex]&,rootintervals[[2,;;tmpindex]]];
    If[SameQ[A0[[rightindex]]/.M,0],
        Return[{{{Equal,A0[[rightindex]],rightrootindex}},{B,A1,A0,{A2,{A0[[rightindex]]}}}}]];
    If[x0>=rootintervals[[1,tmpindex,2]] ||  x0>Root[A0[[rightindex]]/.M1,rightrootindex],
        leftindex=rightindex;
        leftrootindex=rightrootindex;
        If[tmpindex==numroot,
            Return[{{{Greater,A0[[leftindex]],leftrootindex}},{B,A1,A0,{A2,{A0[[leftindex]]}}}}]];
        rightindex=rootintervals[[2,tmpindex+1,1]];
        rightrootindex=Plus@@Map[Count[#,rightindex]&,rootintervals[[2,1;;tmpindex+1]]];
        ,
        If[tmpindex==1,
            Return[{{{Less,A0[[rightindex]],rightrootindex}},{B,A1,A0,{A2,{A0[[rightindex]]}}}}]];
        leftindex=rootintervals[[2,tmpindex-1,1]];
        leftrootindex=Plus@@Map[Count[#,leftindex]&,rootintervals[[2,1;;tmpindex-1]]];
    ];
    If[rightindex==leftindex,
        Return[{{{Greater,A0[[leftindex]],leftrootindex},
            {Less,A0[[rightindex]],rightrootindex}},{B,A1,A0,{A2,{A0[[leftindex]]}}}}],
        Return[{{{Greater,A0[[leftindex]],leftrootindex},
            {Less,A0[[rightindex]],rightrootindex}},{B,A1,A0,{A2,{A0[[leftindex]],A0[[rightindex]]}}}}]]
];
Ps[l_List,M_Association,x_]:=Module[{p1,p2,p3,M1=KeyDrop[M,x]},
    p1=Pc[l[[2]],M1,x];
    p2=Discriminant[l[[3]],x];
    p3=Pr[l[[4,1]],l[[4,2]],x];
    Return[DeleteDuplicates[{Sequence@@l[[1]],Sequence@@p1[[1]],Sequence@@p2,Sequence@@p3}]];
];
Pos[A_List,M_Association,x_,mod_:"Root"]:=
Module[{i,A1,B,M1,p1,p2,p3,A0,A2,x0,rootintervals,numroot,tmpindex,tmprootindex,rightindex,rightrootindex,leftindex,leftrootindex},
    Assert[mod=="Root" || mod=="poly"];
    A1=DeleteDuplicates[Flatten[Map[FactorList,A][[All,All,1]]]];
    B=Select[A1,Not[MemberQ[Variables[#],x]]&];
    A1=Select[A1,MemberQ[Variables[#],x]&];
    M1=KeyDrop[M,x];
    p1=Pc[A1,M1,x][[1]];
    p2=Discriminant[A1,x];
    A0=Select[A1,MemberQ[Variables[#/.M1],x]&];
    If[Length[A0]==0,Return[{DeleteDuplicates[Flatten[{B,p1,p2}]],x}]];
    rootintervals=RootIntervals[A0/.M1];
    numroot=Length[rootintervals[[1]]];
    If[numroot==0,
        If[SameQ[mod,"Root"],Return[{DeleteDuplicates[Flatten[{B,p1,p2}]],True}]];
        If[SameQ[mod,"Poly"],Return[{DeleteDuplicates[Flatten[{B,p1,p2}]],{}}]];
    ];
    A2=A0[[DeleteDuplicates[Flatten[rootintervals[[2]]]]]];
    tmpindex=FirstPosition[A0/.M,0,{0},1][[1]];
    If[tmpindex!=0,
        tmprootindex=0;
        For[i=1,i<=numroot && (M[x]>rootintervals[[1,i,1]] || M[x]>=rootintervals[[1,i,2]]),++i,
            tmprootindex+=Count[rootintervals[[2,i]],tmpindex]];
        If[Length[A2]>1,p3=Pr[A2,{A0[[tmpindex]]},x],p3={}];
        If[SameQ[mod,"Root"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
                               x==Root[A0[[tmpindex]]/.x->#&,tmprootindex]}]];
        If[SameQ[mod,"Poly"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
                               {{Equal,A0[[tmpindex]],tmprootindex}}}]];
    ];
    tmpindex=Max[LengthWhile[rootintervals[[1]],M[x]>#[[1]]&],1];
    rightindex=rootintervals[[2,tmpindex,1]];
    rightrootindex=Plus@@Map[Count[#,rightindex]&,rootintervals[[2,1;;tmpindex]]];
    x0=Root[A0[[rightindex]]/.M1,rightrootindex];
    If[M[x]<x0,
        If[tmpindex==1,
            p3=Pr[A2,{A0[[rightindex]]},x];
            If[SameQ[mod,"Root"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
                x<Root[A0[[rightindex]]/.(x->#)&,rightrootindex]}]];
            If[SameQ[mod,"Poly"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
                {{Less,A0[[rightindex]],rightrootindex}}}]];
        ];
        leftindex=rootintervals[[2,tmpindex-1,1]];
        leftrootindex=Plus@@Map[Count[#,leftindex]&,rootintervals[[2,1;;tmpindex-1]]];
        ,
        leftindex=rightindex;
        leftrootindex=rightrootindex;
        If[tmpindex==numroot,
            p3=Pr[A2,{A0[[leftindex]]},x];
            If[SameQ[mod,"Root"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
                Root[A0[[leftindex]]/.(x->#)&,leftrootindex]<x}]];
            If[SameQ[mod,"Poly"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
                {{Greater,A0[[leftindex]],leftrootindex}}}]];
        ];
        rightindex=rootintervals[[2,tmpindex+1,1]];
        rightrootindex=Plus@@Map[Count[#,rightindex]&,rootintervals[[2,1;;tmpindex+1]]];
    ];
    If[rightindex==leftindex,
        p3=Pr[A2,{A0[[leftindex]]},x],
        p3=Pr[A2,{A0[[rightindex]],A0[[leftindex]]},x]];
    If[SameQ[mod,"Root"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
       Root[A0[[leftindex]]/.(x->#)&,leftrootindex]<x<Root[A0[[rightindex]]/.(x->#)&,rightrootindex]}]];
    If[SameQ[mod,"Poly"],Return[{DeleteDuplicates[Flatten[{B,p1,p2,p3}]],
       {{Greater,A0[[leftindex]],leftrootindex},
        {Less,A0[[rightindex]],rightrootindex}}}]];
];
ClauseResolve[Clause_,E_,F_]:=Union[Clause,E]/.{F->Nothing,(-F)->Nothing};
Leadcoeff[F_,x_]:=Last[CoefficientList[F,x]];
CheckConflictHalf[conflictstatelist_List,f1_,x_,l_Integer,isgreat_,isequal_]:=
Module[{isclose,rootnum,a,b,k,midcheck,skip,selectstate,status=False,rootindex,newconflictstatelist={},listindex,listlength},
    isclose=!isequal;
    If[SameQ[f1,0],
        If[isclose,Return[{False,{{-Infinity,Infinity,False,l}}}],Return[{True,conflictstatelist}]]
    ];
    rootnum=CountRoots[f1,x];
    If[SameQ[rootnum, 0],
        If[Not[Xor[Leadcoeff[f1,x]>0,isgreat]],
            Return[{True,conflictstatelist}],Return[{False,{{-Infinity,Infinity,False,l}}}]
        ]
    ];
    If[Not[Xor[Leadcoeff[f1,x]>0 && Mod[rootnum,2]==0 || Leadcoeff[f1,x]<0 && Mod[rootnum,2]==1 ,isgreat]],
        a=Root[f1,1];
        rootindex=2;
        If[rootindex>rootnum,b=Infinity,b=Root[f1,rootindex]];
        ,
        a=-Infinity;b=Root[f1,1];
        rootindex=1;
    ];
    skip=NestWhile[(If[#<rootnum,a=Root[f1,#+1];If[#+2>rootnum,b=Infinity,b=Root[f1,#+2]]];#+2)&,
            #, #<=rootnum+1 && a==b&]&;
    If[!isclose, rootindex=skip[rootindex]];
    listindex=1;
    listlength=Length[conflictstatelist];
    midcheck=(status || (Length[newconflictstatelist]>0 &&
                    (#1>newconflictstatelist[[-1,2]] ||
                        #1==newconflictstatelist[[-1,2]] && !#2 && !newconflictstatelist[[-1,3]]) ||
                    Length[newconflictstatelist]==0 && #1!=-Infinity
                ))&;
    While[listindex<=listlength && rootindex<rootnum+2 ,
        If[a<conflictstatelist[[listindex,1]] ||
            (a==conflictstatelist[[listindex,1]] &&
                ((a!=-Infinity && isclose && !conflictstatelist[[listindex,3]]) ||
                 ((a==-Infinity || isclose|| !conflictstatelist[[listindex,3]]) &&
                    (b>conflictstatelist[[listindex,2]] ||
                        (b==conflictstatelist[[listindex,2]] &&
                            (isclose|| !conflictstatelist[[listindex,3]]|| b==Infinity)
                        )
                    )
                 )
                )
            ),
            status=midcheck[a,isclose];
            AppendTo[newconflictstatelist,{a,b,isclose,l}];
            If[b==Infinity,
                Return[{status,newconflictstatelist}];
            ];
            listindex=NestWhile[#+1&,listindex,
                #<=listlength &&
                    (b>conflictstatelist[[#,2]] ||
                     (isclose || !conflictstatelist[[#,3]]) && b==conflictstatelist[[#,2]])&
            ];
            ++rootindex;++rootindex;
            If[rootindex>rootnum+1 ,Break[]];
            a=Root[f1,rootindex-1];
            If[rootindex>rootnum,b=Infinity,b=Root[f1,rootindex]];
            If[!isclose, rootindex=skip[rootindex]];
            ,
            status=midcheck[conflictstatelist[[listindex,1]],conflictstatelist[[listindex,3]]];
            AppendTo[newconflictstatelist,conflictstatelist[[listindex]]];
            If[conflictstatelist[[listindex,2]]==Infinity,
                Return[{status,newconflictstatelist}];
            ];
            k=rootindex;
            rootindex=NestWhile[(If[#+2>rootnum,b=Infinity,b=Root[f1,#+2]];#+2)&,rootindex,
                #<=rootnum+1 && (
                    newconflictstatelist[[-1,2]]>b ||
                    (!isclose || newconflictstatelist[[-1,3]]) && b==newconflictstatelist[[-1,2]] )&
            ];
            ++listindex;
            If[rootindex>rootnum+1,Break[]];
            If[rootindex>k,a=Root[f1,rootindex-1]];
            If[isclose,rootindex=
                NestWhile[(If[#<rootnum,a=Root[f1,#+1];If[#+2>rootnum,b=Infinity,b=Root[f1,#+2]]];#+2)&,
                  rootindex, #<=rootnum+1 && b<=newconflictstatelist[[-1,2]]&]];
            If[!isclose, rootindex=skip[rootindex]];
        ]
    ];
    If[listindex<=listlength,
        status=midcheck[conflictstatelist[[listindex,1]],conflictstatelist[[listindex,3]]];
        Scan[(status=midcheck[#[[1]],#[[3]]];AppendTo[newconflictstatelist,#])&,
            conflictstatelist[[listindex;;]]]
    ];
    If[rootindex<rootnum+2,
        status=midcheck[a,isclose];
        AppendTo[newconflictstatelist,{a,b,isclose,l}];
        Scan[(a=Root[f1,#];b=If[#>=rootnum,Infinity,Root[f1,#+1]];
                If[isclose  && b>newconflictstatelist[[-1,2]] || a!=b,
                    status=midcheck[a,isclose];
                    AppendTo[newconflictstatelist,{a,b,isclose,l}]])&,
                        Range[rootindex+1,rootnum,2]]
    ];
    (* The union may be empty when nonstrict input has no forbidden point.
       The whole line is then feasible; there is no last interval to inspect. *)
    If[newconflictstatelist==={},Return[{True,{}}]];
    If[!status && newconflictstatelist[[-1,2]]!=Infinity,status=True];
    Return[{status,newconflictstatelist}]
];
CheckConflictHalf[conflictstatelist_List,r_,l_Integer,isgreat_,isequal_]:=
Module[{isclose,status=False,index,newlist},
    isclose=!isequal;
    If[!isgreat,
        If[r==-Infinity,Return[{False,{{-Infinity,Infinity,isclose,l}}}]];
        newlist=TakeWhile[conflictstatelist,
            (#[[1]]<r || !isclose && #[[3]] && #[[1]]==r)&];
        If[Length[newlist]==0 || newlist[[-1,2]]!=Infinity,
            AppendTo[newlist,{r,Infinity,isclose,l}]];
    ,
        If[r==Infinity,Return[{False,{{-Infinity,Infinity,isclose,l}}}]];
        index=LengthWhile[conflictstatelist,
            (#[[2]]<r || (isclose || !#[[3]]) && #[[2]]==r)&];
        newlist=conflictstatelist[[index+1;;]];
        If[Length[newlist]==0 || newlist[[1,1]]!=-Infinity,
            newlist={{-Infinity,r,isclose,l},Sequence@@newlist}];
    ];
    If[newlist[[1,1]]!=-Infinity || newlist[[-1,2]]!=Infinity,Return[{True,newlist}]];
    Scan[
           (If[newlist[[#-1,2]]<newlist[[#,1]] ||
                !newlist[[#,3]] && !newlist[[#-1,3]] && newlist[[#-1,2]]==newlist[[#,1]],
                status=True;Return[]])&,Range[2,Length[newlist]]];
    Return[{status,newlist}];
];
FindMid[x_,y_]:=Module[{x1=1,y1=0},
    NestWhile[(x1=IsolatingInterval[x,#][[2]];y1=IsolatingInterval[y,#][[1]];#/10)&,1,x1>=y1&];
    Return[(y1+x1)/2];
];
FindMid[conflictstatelist_List]:=Module[{len=0,mid=Infinity,x},
    len=Length[conflictstatelist];
    If[len==0,Return[1]];
    If[conflictstatelist[[1,1]]!=-Infinity,
        x=IsolatingInterval[conflictstatelist[[1,1]]];
        Return[If[x[[1]]<x[[2]],x[[1]],x[[1]]-1/10]];
    ];
    If[conflictstatelist[[-1,2]]!=Infinity,
       x=IsolatingInterval[conflictstatelist[[-1,2]]];
        Return[If[x[[1]]>x[[2]],x[[2]],x[[2]]+1/10]];
    ];
    Scan[If[conflictstatelist[[#-1,2]]<conflictstatelist[[#,1]],
            mid=FindMid[conflictstatelist[[#-1,2]],conflictstatelist[[#,1]]];
            Return[],
            If[mid==Infinity && conflictstatelist[[#-1,2]]==conflictstatelist[[#,1]] &&
                !conflictstatelist[[#-1,3]] && !conflictstatelist[[#,3]],
                mid=conflictstatelist[[#-1,2]]]]&,
     Range[2,len]];
    Return[mid];
];

runCore[Clause0_,F2_,X_,opts_]:=Module[{a,cc,i,j,xmap=<||>,fmap=<||>,F1,F,Flevel,Fnow,conflictstatelist,Ci,Cli,Clause,Clause1,Clearn={},
                varnum,Clausenum,assignment=Association[Map[#->0&,X]],lorder,z,lnum,ML,M,Morder,VC,
                Cstatus,Clstatus,levell,levelc,levelcl,level,tmplevel,tmpc,tmpcl,status,nowc,conflict,
                getFnow,getFlevel,getClause,checkconflict,Polynomialroot,getorder,addl,getF,
                samplecell,getsamplecell,nextsamplecell,cons,consZero,lenPoly,maxlevel=1,
afterAssign=Lookup[opts,"AfterAssign",None],onTheoryConflict=Lookup[opts,"OnTheoryConflict",None],
shouldSwitch=Lookup[opts,"ShouldSwitch",None],hookResult,suggestions,proposal,
candidateKeys=Keys[safeAssignment[X,Lookup[opts,"InitialAssignment",<||>]]],coreExit=Unique["mcsatCoreExit"]},
    Catch[
    Clause=Clause0; F1=F2; F=Map[{1,#}&,F1];
    assignment=Join[assignment,safeAssignment[X,Lookup[opts,"InitialAssignment",<||>]]];
    lnum=Length[F];
    Module[{x0=X[[1]],C={}},
    Scan[
        If[(F1/.{#->x0,x0->#})==F1,AppendTo[F,{1,#-x0}];++lnum;AppendTo[C,{-lnum}];x0=#]&
    ,X[[2;;]]];
    If[Length[C]>Length[X]/2,Clause={Sequence@@C,Sequence@@Clause}]
    ];
    varnum=Length[X];
    Clausenum=Length[Clause];
    Scan[(xmap[X[[#]]]=# )&,Range[varnum]];
    Scan[(fmap[F[[#]]]=# )&,Range[lnum]];
    getorder=Function[l,
        Switch[l[[1]],
            1,Max[Map[xmap[#]&,Variables[l[[2]]]]],
            2,Max[Map[xmap[#]&,Variables[l[[2]]]]],
            3,xmap[l[[4]]],
            4,xmap[l[[4]]],
            5,Length[l[[3]]]
        ]
    ];
    Ci=Table[{},varnum];
    Cli=Table[{},varnum];
    levell=Table[{},varnum];
    conflictstatelist=Table[{},varnum];
     lorder=Map[Max[Map[xmap[#]&,Variables[#[[2]]]]]&,F];
    Scan[AppendTo[Ci[[Max[Map[lorder[[Abs[#]]]&,Clause[[#]]]]]],#]&,Range[Clausenum]];
    Scan[AppendTo[levell[[lorder[[#]]]],#]&,Range[lnum]];
    Flevel=Table[0,lnum];
    Fnow=Table[0,lnum];VC={Table[{},lnum],Table[{},lnum]};
    Cstatus=Table[{0,0},Clausenum];Clstatus={};
    level=1;
    ML=Table[{},varnum];
    Morder=Table[0,lnum];M=Table[0,lnum];
    levelc=Table[{},varnum];levelcl=Table[{},varnum];
    conflictstatelist[[level]]={};
    Scan[(Flevel[[#]]=F1[[#]]/.(X[[1]]->z))&,levell[[level]]];
    levelc[[level]]=Map[{Clause[[#]],#}&,Ci[[level]]];
    For[i=1,i<=Length[levelc[[level]]],++i,
        Scan[AppendTo[VC[[Sign[#],Abs[#]]], levelc[[level,i,2]] ]&,levelc[[level,i,1]]];
        Cstatus[[levelc[[level,i,2]]]]={Length[levelc[[level,i,1]]],0}
    ];
    Polynomialroot[F_,Index_]:=If[Index>CountRoots[F,z],Infinity,Root[F,Index]];
    getsamplecell=Function[{l,a},
        Module[{newl},
            If[Length[a]!=0,
                newl=getF[{5,l,a}];
                ,newl=Nothing];
            newl]];
    nextsamplecell=Function[{lst,a,x0},
        Module[{pc=GetSampleInterval[lst,a,x0],nextl,fg,fl},
            nextl={getsamplecell[pc[[2]],a[[;;-2]]]};
            Scan[(
                    fg=getF[{3,#[[2]]/.(x0->z),#[[3]],x0}];
                    fl=getF[{4,#[[2]]/.(x0->z),#[[3]],x0}];
                    Switch[#[[1]],
                        Greater,AppendTo[nextl,-fg],
                        Equal,AppendTo[nextl,fg];AppendTo[nextl,fl],
                        Less,AppendTo[nextl,-fl]]
                )&,pc[[1]]];
            nextl
        ]
    ];
    samplecell=Function[i,If[F[[i,1]]==5 && SameQ[F[[i,4]],False],
        Module[{newlist=If[Length[F[[i,2]]]==1,
                            Pmc[F[[i,2,1]],assignment,X[[lorder[[i]]+1]]],
                            Ps[F[[i,2]],F[[i,3]],X[[lorder[[i]]+1]]]],
                x0=X[[lorder[[i]]]]},
                F[[i,4]]=nextsamplecell[newlist,F[[i,3]],x0];
        ]]];
    getFnow=(Switch[F[[#,1]],
        1,(F[[#,2]]/.assignment)>0,
        2,(F[[#,2]]/.assignment)==0,
        3,assignment[[lorder[[#]]]]>Flevel[[#]],
        4,assignment[[lorder[[#]]]]<Flevel[[#]],
        5,If[assignment[[;;lorder[[#]]]]==F[[#,3]],
            False,
            samplecell[#];
            MemberQ[Map[
                    (!Xor[Fnow[[Abs[#]]],#>0])&
                    ,F[[#,4]]],True]]
    ])&;
    getFlevel=(Switch[F[[#,1]],
        1,F[[#,2]]/.(X[[level]]->z)/.assignment,
        2,F[[#,2]]/.(X[[level]]->z)/.assignment,
        3,Polynomialroot[F[[#,2]]/.assignment,F[[#,3]]],
        4,Polynomialroot[F[[#,2]]/.assignment,F[[#,3]]],
        _,False
    ])&;
    getClause=Function[{c,l,strictInput},
        Select[
            Map[{Map[
                    If[lorder[[Abs[#]]]==level,#,
                        If[strictInput && F[[Abs[#],1]]==1,
                           If[#>0,TrueQ[(F[[Abs[#],2]]/.assignment)>0],TrueQ[(F[[Abs[#],2]]/.assignment)<0]],
                           !Xor[Fnow[[Abs[#]]],#>0]]]&
                ,c[[#]]]/.(False->Nothing),#}&,l],
            Not[MemberQ[#[[1]],True]]&]
    ];
    checkconflict=Function[{list,index},
        Switch[F[[Abs[index],1]],
            1,CheckConflictHalf[list,Flevel[[Abs[index]]],z,index,index>0,False],
            3,CheckConflictHalf[list,Flevel[[Abs[index]]],index,index>0,False],
            4,CheckConflictHalf[list,Flevel[[Abs[index]]],index,index<0,False]]
    ];
    getF=Function[l,
        Module[{ans=fmap[l]},
            If[SameQ[Head[ans],Missing],
                AppendTo[F,l];++lnum;ans=lnum;fmap[l]=lnum;
                If[l[[1]]==5,AppendTo[F[[ans]],False]];
                AppendTo[lorder,getorder[l]];
                AppendTo[levell[[lorder[[ans]]]],lnum];AppendTo[Flevel,0];
                AppendTo[Fnow,0];AppendTo[M,0];
                AppendTo[Morder,0];AppendTo[VC[[1]],{}];AppendTo[VC[[-1]],{}];
                Flevel[[ans]]=getFlevel[ans];
                If[level>lorder[[ans]],Fnow[[ans]]=getFnow[ans]];
            ];
            ans
        ]
    ];
    addl=Function[l,
        Module[{index=l[[1]]},
            M[[Abs[index]]]=Sign[index];AppendTo[ML[[level]],l];Morder[[Abs[index]]]=Length[ML[[level]]];
            Scan[If[#>0,++Cstatus[[#,2]];--Cstatus[[#,1]],++Clstatus[[-#,2]];--Clstatus[[-#,1]]]&,VC[[Sign[index],Abs[index]]]];
            Scan[If[#>0,--Cstatus[[#,1]],--Clstatus[[-#,1]]]&,VC[[-Sign[index],Abs[index]]]];
        ]
    ];
    While[True,
        If[shouldSwitch=!=None && TrueQ[shouldSwitch[]],Throw[{"switch","OpenCAD",assignment},coreExit]];
		tmpc=MinimalBy[Select[Range[Length[levelc[[level]]]],Cstatus[[levelc[[level,#,2]],2]]==0&],Cstatus[[levelc[[level,#,2]],1]]&];
        tmpcl=MinimalBy[Select[Range[Length[levelcl[[level]]]],Clstatus[[levelcl[[level,#,2]],2]]==0&],Clstatus[[levelcl[[level,#,2]],1]]&];
        If[Length[tmpc]==0 && Length[tmpcl]==0,
            If[!MemberQ[candidateKeys,X[[level]]] || AnyTrue[conflictstatelist[[level]],
                Function[cell,TrueQ[cell[[1]]<assignment[X[[level]]]<cell[[2]]] ||
                  (TrueQ[cell[[3]]] && (TrueQ[cell[[1]]==assignment[X[[level]]]] || TrueQ[cell[[2]]==assignment[X[[level]]]]))]],
              assignment[X[[level]]]=FindMid[conflictstatelist[[level]]]];
            Scan[If[M[[#]]!=0,Fnow[[#]]=M[[#]]>0,If[F[[#,1]]!=5,Fnow[[#]]=getFnow[#]]]&,levell[[level]]];
            Scan[If[M[[#]]==0 && F[[#,1]]==5,Fnow[[#]]=getFnow[#]]&,levell[[level]]];
            ++level;maxlevel=Max[maxlevel,level-1];
            If[level>varnum,Throw[{"sat","mcsat",assignment},coreExit]];
            If[afterAssign=!=None,
              hookResult=afterAssign[KeyTake[assignment,Take[X,level-1]],assignment,level,maxlevel];
              If[AssociationQ[hookResult],
                If[Lookup[hookResult,"status",None]==="sat" || !KeyExistsQ[hookResult,"status"],
                  proposal=If[Lookup[hookResult,"status",None]==="sat",Lookup[hookResult,"assignment",<||>],hookResult];
                  If[modelQ[Clause0,F2,X,proposal],Throw[{"sat","MCSAT:local-search",proposal},coreExit],
                    Throw[{"unknown","MCSAT:invalid-callback-model"},coreExit]],
                  If[Lookup[hookResult,"status",None]==="unknown",
                    suggestions=safeAssignment[Drop[X,level-1],Lookup[hookResult,"assignment",<||>]];
                    assignment=Join[assignment,suggestions];
                    candidateKeys=Union[candidateKeys,Keys[suggestions]]]]]];

            conflictstatelist[[level]]={};
            Scan[(M[[#]]=0)&,levell[[level]]];ML[[level]]={};
            Scan[(Flevel[[#]]=getFlevel[#])&,levell[[level]]];
            levelc[[level]]=getClause[Clause,Ci[[level]],True];
            levelcl[[level]]=getClause[Clearn,Cli[[level]],False];
            Scan[(VC[[1,#]]={};VC[[-1,#]]={})&,levell[[level]] ];
            For[i=1,i<=Length[levelc[[level]]],++i,
                Scan[AppendTo[VC[[Sign[#],Abs[#]]], levelc[[level,i,2]] ]&,levelc[[level,i,1]]];
                Cstatus[[levelc[[level,i,2]]]]={Length[levelc[[level,i,1]]],0}
            ];
            For[i=1,i<=Length[levelcl[[level]]],++i,
                Scan[AppendTo[VC[[Sign[#],Abs[#]]], -levelcl[[level,i,2]] ]&,levelcl[[level,i,1]]];
                Clstatus[[levelcl[[level,i,2]]]]={Length[levelcl[[level,i,1]]],0}
            ];
        ,
            status=-1;
            If[Length[tmpc]>0,
                If[Cstatus[[levelc[[level,tmpc[[1]],2]],1]]==0,status=0;nowc=tmpc[[1]],
                    If[Cstatus[[levelc[[level,tmpc[[1]],2]],1]]==1,status=1;nowc=tmpc[[1]],status=2;nowc=tmpc[[1]]]]
            ];
            If[status!=0 && Length[tmpcl]>0,
                If[Clstatus[[levelcl[[level,tmpcl[[1]],2]],1]]==0,status=0;nowc=-tmpcl[[1]],
                    If[Clstatus[[levelcl[[level,tmpcl[[1]],2]],1]]==1 && status!=1,status=1;nowc=-tmpcl[[1]]];
                    If[status==-1,status=2;nowc=-tmpcl[[1]]]
                ]
            ];
            If[status==0,
                If[nowc>0,conflict=Clause[[levelc[[level,nowc,2]]]],conflict=Clearn[[levelcl[[level,-nowc,2]]]]];
                While[status==0,
                    For[a = Select[conflict, lorder[[Abs[#]]]==level && M[[Abs[#]]]!=0 && Length[ML[[level,Morder[[Abs[#]]]]]] == 2 &],Length[a] != 0,
                               a = Select[conflict, lorder[[Abs[#]]]==level && M[[Abs[#]]]!=0 && Length[ML[[level,Morder[[Abs[#]]]]]] == 2 &],
                        conflict = Fold[ClauseResolve[#1, ML[[level,Morder[[Abs[#2]]],2]], #2] &, conflict, a];
                    ];
                    If[Length[conflict]==0,Throw[{"unsat","mcsat"},coreExit]];
                    If[conflict==={},Throw[{"unsat","mcsat"},coreExit]];
                    tmplevel=Max[Map[lorder[[Abs[#]]]&,conflict]];
                    If[tmplevel==level,
                        a=Select[conflict,(lorder[[Abs[#]]]==level && F[[Abs[#],1]]==5)&];
                        If[Length[a]!=0,
                            conflict=DeleteDuplicates[
                                Fold[(If[#2<0,Print["error:",  #, " in conflict ."]];
                                samplecell[#2];#1/.(#2->Sequence@@F[[#2,4]]))&
                                ,conflict,a]];
                            If[conflict==={},Throw[{"unsat","mcsat"},coreExit]];
                    tmplevel=Max[Map[lorder[[Abs[#]]]&,conflict]];
                            ,
                            AppendTo[Clearn,conflict];
                            AppendTo[Cli[[level]],Length[Clearn]];
                            Scan[AppendTo[VC[[Sign[#],Abs[#] ]],-Length[Clearn]]&, Select[conflict,lorder[[Abs[#]]]==level& ] ];
                            a=Select[conflict,lorder[[Abs[#]]]==level&];
                            AppendTo[levelcl[[level]],{a,Length[Clearn]}];
                            AppendTo[Clstatus,{Length[Select[a,M[[Abs[#]]]==0&]],0}];
                            If[Clstatus[[-1,1]]<2,status=1,status=2];
                            nowc=-Length[levelcl[[level]]];
                            If[Clstatus[[-1,1]]==0,
                                If[Length[a]==1,a=Max[Map[Morder[[Abs[#]]]&,a]]-1,
                                    a=RankedMax[Map[Morder[[Abs[#]]]&,a],2]];
                                Scan[
                                    (M[[Abs[#[[1]]]]]=0;
                                    Scan[If[#>0,--Cstatus[[#,2]];++Cstatus[[#,1]],--Clstatus[[-#,2]];++Clstatus[[-#,1]]]&,VC[[Sign[#[[1]]],Abs[#[[1]]]]]];
                                    Scan[If[#>0,++Cstatus[[#,1]],++Clstatus[[-#,1]]]&,VC[[-Sign[#[[1]]],Abs[#[[1]]]]]];)&
                                ,ML[[level,a+1;;]]];
                                ML[[level]]=ML[[level,;;a]];
                                conflictstatelist[[level]]=Fold[checkconflict[#1,#2[[1]]][[2]]&,{},ML[[level]]]]]];
                    level=tmplevel;
                ]
            ];
            If[nowc>0,cc=levelc[[level,nowc,1]],cc=levelcl[[level,-nowc,1]]];
            If[status==1,
                a=Select[cc,M[[Abs[#]]]==0&][[1]];
            ,
                a=MaximalBy[Select[cc,M[[Abs[#]]]==0&],Length[Select[VC[[Sign[#],Abs[#]]],If[#<0,Clstatus[[-#,2]]==0,Cstatus[[#,2]]==0]&]]&][[1]];
            ];
            tmpc=checkconflict[conflictstatelist[[level]],a];
            If[tmpc[[1]],
                conflictstatelist[[level]]=tmpc[[2]];
                If[nowc>0,cc=Clause[[levelc[[level,nowc,2]]]],cc=Clearn[[levelcl[[level,-nowc,2]]]]];
            ,
                If[onTheoryConflict=!=None,onTheoryConflict[]];
                cc=DeleteDuplicates[Map[#[[4]]&,tmpc[[2]]]];
                If[level>1,
                    Module[{l},
                        l=Map[Function[x,
                                If[F[[Abs[x],1]]==1 || F[[Abs[x],1]]==2,
                                    F[[Abs[x],2]],
                                    F[[Abs[x],2]]/.(z->X[[level]])]]
                            ,cc];
                        l=Select[DeleteDuplicates[Flatten[Map[FactorList,l][[All,All,1]]]],UnsameQ[Variables[#],{}]&];
                        conflict=getsamplecell[{l},assignment[[;;level-1]]];
                    ]
                    ,
                    conflict=Nothing;
                ];
                cc={Sequence@@Map[Minus,cc],conflict};
                a=-a;
                status=1;
            ];
            If[status==1,addl[{a,cc}],addl[{a}]];
            If[F[[Abs[a],1]]==3 || F[[Abs[a],1]]==4,
                status=getF[{7-F[[Abs[a],1]],Sequence@@F[[Abs[a],2;;]]}];
                If[M[[status]]==0,cc=a;a=-1*Sign[a]*status;cc={a,-cc};addl[{a,cc}];]
            ]
        ]
    ]

    ,coreExit]
];

End[];
EndPackage[];


(* Exact preprocessing helpers for the shared local search driver.
   Bounds come exclusively from original unit clauses; the complete input
   formula must still be checked before reporting SAT. *)
BeginPackage["HELMSLocalSupport`"];
UnitLinearIntervals::usage = "UnitLinearIntervals[p,c,v] derives exact open rational intervals only from original unit affine clauses.";
OriginalStyleInitialAssignment::usage = "OriginalStyleInitialAssignment[v,intervals,round] gives an exact strict-interior assignment with the source initialization preferences.";
LineParameterInterval::usage = "LineParameterInterval[v,a,d,intervals] restricts t in a+t d to the known open bounds.";
IntervalLineSamples::usage = "IntervalLineSamples[q,sign,t,{lower,upper}] returns one rational sample per allowed open sector satisfying sign*q>0.";
NearestIntervalLineSamples::usage = "NearestIntervalLineSamples[q,sign,t,domain] returns the nearest of the generated allowed sector samples.";
SourceDirectionVectors::usage = "Exact gradient/current/random directions with source filtering.";
SourceDirectionFamily::usage = "Combined line directions and the original random subset for planar pairing.";
CompactRootInterval::usage = "Exact root enclosure with rational endpoint size controlled by the requested width.";
CompactRootIntervals::usage = "Disjoint enclosures for every distinct real root, refined exactly when needed.";
PolynomialSectorSamples::usage = "PolynomialSectorSamples[q,t,domain] returns an exact rational sample from every root-free open sector of a rational polynomial in the open rational domain.";
$SectorSamplePolicy::usage = "$SectorSamplePolicy selects one exact rational point per univariate sector: near-origin favors small moves; interior favors a midpoint for bounded sectors.";
$SectorSamplePolicy = "near-origin";
Begin["`Private`"];

(* Rational roots otherwise give singleton isolators that preserve every
   denominator bit. Grid brackets bound endpoint size without floating-point
   rounding. Existing callers still refine until neighboring roots separate. *)
CompactRootInterval[root_, width_] := If[
  (IntegerQ[root] || Head[root] === Rational) && TrueQ[width > 0],
  With[{denominator = Ceiling[1/width]},
    {Floor[denominator root]/denominator, Ceiling[denominator root]/denominator}],
  IsolatingInterval[root, width]];

CompactRootIntervals[roots_List, width_] := Module[
  {ordered = Sort[DeleteDuplicates[roots, TrueQ[#1 == #2] &], Less],
   currentWidth = width, intervals},
  intervals = CompactRootInterval[#, currentWidth] & /@ ordered;
  While[! And @@ Table[TrueQ[intervals[[i,2]] < intervals[[i+1,1]]],
      {i, Length[intervals]-1}],
    currentWidth /= 10;
    intervals = CompactRootInterval[#, currentWidth] & /@ ordered];
  intervals
];

RationalQ[x_] := IntegerQ[x] || Head[x] === Rational;
InsideQ[x_, {lo_, hi_}] := TrueQ[lo < x < hi];

UnitLinearIntervals[p_List, c_List, v_List] := Module[
  {bounds = AssociationThread[v, ConstantArray[{-Infinity, Infinity}, Length[v]]],
   used = {}, consistent = True, atom, q, involved, x, coefficient, constant, old, b},
  Do[
    If[clause === {}, consistent = False; Continue[]];
    If[Length[clause] =!= 1, Continue[]];
    atom = First[clause]; q = Expand[atom[[2]] p[[atom[[1]]]]];
    involved = Select[v, ! FreeQ[q, #] &];
    If[involved === {},
      If[RationalQ[q] && ! TrueQ[q > 0], consistent = False]; Continue[]];
    If[Length[involved] =!= 1, Continue[]];
    x = First[involved];
    If[! PolynomialQ[q, {x}] || Exponent[q, x] =!= 1, Continue[]];
    coefficient = Coefficient[q, x]; constant = q /. x -> 0;
    If[! RationalQ[coefficient] || ! RationalQ[constant] || coefficient === 0,
      Continue[]];
    b = -constant/coefficient; old = bounds[x];
    bounds[x] = If[TrueQ[coefficient > 0],
      {Max[old[[1]], b], old[[2]]}, {old[[1]], Min[old[[2]], b]}];
    AppendTo[used, atom];
    If[! TrueQ[bounds[x][[1]] < bounds[x][[2]]], consistent = False],
    {clause, c}];
  <|"intervals" -> bounds, "consistent" -> consistent,
    "used_atoms" -> DeleteDuplicates[used]|>
];

(* The open endpoints must never be sampled. In particular the numerator is
   strictly smaller than its denominator, correcting the endpoint draw in the
   historical initialization code. *)
InteriorFraction[] := Module[{denominator = RandomInteger[{2, 100}]},
  RandomInteger[{1, denominator - 1}]/denominator];

InitialCoordinate[{lo_, hi_}, round_Integer] := Module[{preferred},
  If[! TrueQ[lo < hi], Return[Missing["EmptyOpenInterval"]]];
  Which[
    round === 1,
      Which[InsideQ[1, {lo, hi}], 1,
        lo =!= -Infinity && hi =!= Infinity, (lo + hi)/2,
        lo =!= -Infinity, lo + 1/2, True, hi - 1/2],
    2 <= round <= 6,
      preferred = Select[{-1, 1}, InsideQ[#, {lo, hi}] &];
      Which[Length[preferred] === 2, RandomChoice[preferred],
        lo =!= -Infinity && hi =!= Infinity, lo + (hi - lo) InteriorFraction[],
        preferred =!= {}, First[preferred],
        lo =!= -Infinity, lo + 1/2, True, hi - 1/2],
    True,
      Which[lo =!= -Infinity && hi =!= Infinity, lo + (hi - lo) InteriorFraction[],
        lo === -Infinity && hi === Infinity, -50 + 100 InteriorFraction[],
        lo =!= -Infinity, If[TrueQ[lo < 50], lo + (50 - lo) InteriorFraction[], lo + 1/2],
        True, If[TrueQ[-50 < hi], -50 + (hi + 50) InteriorFraction[], hi - 1/2]]]
];

OriginalStyleInitialAssignment[v_List, intervals_Association, round_Integer] :=
  AssociationThread[v, (InitialCoordinate[intervals[#], round] &) /@ v];

LineParameterInterval[v_List, a_Association, d_List, intervals_Association] := Module[
  {lo = -Infinity, hi = Infinity, bound, current, direction, local, inconsistent = False},
  If[Length[v] =!= Length[d], Return[Missing["DirectionDimension"]]];
  Do[
    bound = intervals[v[[i]]]; current = a[v[[i]]]; direction = d[[i]];
    If[TrueQ[direction == 0],
      If[! InsideQ[current, bound], inconsistent = True; Break[]],
      local = If[TrueQ[direction > 0],
        {(bound[[1]] - current)/direction, (bound[[2]] - current)/direction},
        {(bound[[2]] - current)/direction, (bound[[1]] - current)/direction}];
      lo = Max[lo, local[[1]]]; hi = Min[hi, local[[2]]]],
    {i, Length[v]}];
  If[! inconsistent && TrueQ[lo < hi], {lo, hi}, Missing["EmptyOpenInterval"]]
];

RationalInterior[lo_, hi_] := Module[{denominator = 1, value},
  If[! TrueQ[lo < hi], Return[Missing["EmptyOpenInterval"]]];
  If[InsideQ[0, {lo, hi}], Return[0]];
  If[lo === -Infinity, Return[Floor[hi] - 1]];
  If[hi === Infinity, Return[Ceiling[lo] + 1]];
  While[True,
    value = (Floor[denominator lo] + 1)/denominator;
    If[InsideQ[value, {lo, hi}], Return[value]];
    denominator *= 10]
];

(* Work with primitive integer polynomials throughout root isolation.  In
   Mathematica 14, constructing exact Root objects and then comparing or
   isolating those objects can terminate the kernel on rational polynomials
   with very large coefficients.  RootIntervals accepts the integer polynomial
   directly and returns ordered rational brackets.  No approximate root or
   floating-point sign test is used here. *)
PrimitiveIntegerPolynomial[q_, t_] := Module[{coefficients, denominator, content},
  If[q === 0, Return[0]];
  If[! PolynomialQ[q, {t}], Return[$Failed]];
  coefficients = CoefficientList[q, t];
  If[coefficients === {}, Return[0]];
  If[! And @@ (RationalQ /@ coefficients), Return[$Failed]];
  denominator = LCM @@ (Denominator /@ coefficients);
  coefficients *= denominator;
  content = GCD @@ coefficients;
  If[content === 0, Return[0]];
  Expand[FromDigits[Reverse[coefficients/content], t]]
];

(* Every non-singleton RootIntervals bracket contains exactly one root in
   its interior.  Its endpoint can be a different rational root, so use the
   one-sided sign of the square-free polynomial at that endpoint. *)
RefinePolynomialBracket[p_, dp_, t_, {lo_, hi_}] := Module[{middle, left, value},
  If[lo === hi, Return[{lo, hi}]];
  middle = (lo + hi)/2; value = p /. t -> middle;
  If[value === 0, Return[{middle, middle}]];
  left = p /. t -> lo;
  If[left === 0, left = dp /. t -> lo];
  If[Sign[left] === Sign[value], {middle, hi}, {lo, middle}]
];

(* Minimize displacement along the search line within each cell.  A midpoint
   of an entire bounded cell may unnecessarily leave constraints that were
   already satisfied.  The point below stays strictly inside the cell and
   close to the boundary on the side of the current assignment t == 0.
   Choose a short decimal rational in that safe window rather than adding a
   constant to an endpoint with a potentially enormous denominator. *)
NearOriginSectorSample[lo_, hi_] := Module[{step = 1/10000},
  If[! TrueQ[lo < hi], Return[Missing["EmptyOpenInterval"]]];
  If[InsideQ[0, {lo, hi}], Return[0]];
  If[lo =!= -Infinity && hi =!= Infinity, step = Min[step, (hi - lo)/4]];
  If[TrueQ[lo >= 0], RationalInterior[lo, lo + step],
    -RationalInterior[-hi, -hi + step]]
];

(* A second, deterministic representative gives restart rounds a different
   jump scale.  Both policies sample exactly one point per open sector and
   retain the same exact root isolation and final sign checks. *)
SectorSample[lo_, hi_] := If[$SectorSamplePolicy === "interior",
  Which[
    ! TrueQ[lo < hi], Missing["EmptyOpenInterval"],
    lo === -Infinity && hi === Infinity, 1,
    lo === -Infinity || hi === Infinity, NearOriginSectorSample[lo, hi],
    True, (lo + hi)/2],
  NearOriginSectorSample[lo, hi]
];

PolynomialSectorSamples[q_, t_, domain_ : {-Infinity, Infinity}] := Module[
  {poly = Expand[q], lo, hi, primitive, squarefree, derivative, isolated,
   brackets, selected = {}, bracket, discard, currentWidth, denominator,
   compact, samples, left, right, i},
  If[! MatchQ[domain, {_, _}], Return[{}]];
  {lo, hi} = domain;
  If[! (lo === -Infinity || RationalQ[lo]) ||
      ! (hi === Infinity || RationalQ[hi]) || ! TrueQ[lo < hi], Return[{}]];
  primitive = PrimitiveIntegerPolynomial[poly, t];
  If[primitive === $Failed || primitive === 0, Return[{}]];
  If[FreeQ[primitive, t], Return[{SectorSample[lo, hi]}]];
  squarefree = PrimitiveIntegerPolynomial[
    PolynomialQuotient[primitive, PolynomialGCD[primitive, D[primitive, t]], t], t];
  derivative = D[squarefree, t];
  isolated = Quiet[RootIntervals[squarefree]];
  If[! MatchQ[isolated, {_List, _List}], Return[{}]];
  brackets = First[isolated];
  If[! And @@ (MatchQ[#, {_?RationalQ, _?RationalQ}] &&
      TrueQ[#[[1]] <= #[[2]]] & /@ brackets), Return[{}]];
  (* Resolve domain membership using only rational comparisons.  A root on
     an open domain endpoint is excluded rather than treated as a sector. *)
  Do[
    bracket = original; discard = False;
    If[TrueQ[bracket[[2]] <= lo] || TrueQ[hi <= bracket[[1]]], Continue[]];
    While[lo =!= -Infinity && TrueQ[bracket[[1]] <= lo < bracket[[2]]],
      If[TrueQ[bracket[[1]] < lo] && (squarefree /. t -> lo) === 0,
        discard = True; Break[]];
      bracket = RefinePolynomialBracket[squarefree, derivative, t, bracket]];
    If[discard || TrueQ[bracket[[2]] <= lo], Continue[]];
    While[hi =!= Infinity && TrueQ[bracket[[1]] < hi <= bracket[[2]]],
      If[TrueQ[hi < bracket[[2]]] && (squarefree /. t -> hi) === 0,
        discard = True; Break[]];
      bracket = RefinePolynomialBracket[squarefree, derivative, t, bracket]];
    If[discard || TrueQ[hi <= bracket[[1]]], Continue[]];
    AppendTo[selected, bracket], {original, brackets}];
  If[selected === {}, Return[{SectorSample[lo, hi]}]];
  (* RootIntervals can use shared endpoints for adjacent open brackets.
     Refine until there is an explicitly rational gap between every pair. *)
  Do[
    While[! TrueQ[selected[[i, 2]] < selected[[i + 1, 1]]],
      selected[[i]] = RefinePolynomialBracket[squarefree, derivative, t, selected[[i]]];
      selected[[i + 1]] = RefinePolynomialBracket[squarefree, derivative, t, selected[[i + 1]]]],
    {i, Length[selected] - 1}];
  currentWidth = 1/10000;
  While[True,
    Do[While[TrueQ[selected[[i, 2]] - selected[[i, 1]] > currentWidth],
      selected[[i]] = RefinePolynomialBracket[squarefree, derivative, t, selected[[i]]]],
      {i, Length[selected]}];
    denominator = Ceiling[1/currentWidth];
    compact = ({Floor[denominator #[[1]]]/denominator,
      Ceiling[denominator #[[2]]]/denominator} &) /@ selected;
    If[TrueQ[lo < compact[[1, 1]]] && TrueQ[compact[[-1, 2]] < hi] &&
      And @@ Table[TrueQ[compact[[i, 2]] < compact[[i + 1, 1]]],
      {i, Length[compact] - 1}], Break[]];
    currentWidth /= 10];
  samples = Table[
    left = If[i === 1, lo, compact[[i - 1, 2]]];
    right = If[i > Length[compact], hi, compact[[i, 1]]];
    SectorSample[left, right], {i, Length[compact] + 1}];
  Select[DeleteDuplicates[samples], RationalQ[#] && InsideQ[#, domain] &&
    (poly /. t -> #) =!= 0 &]
];
PolynomialSectorSamples[___] := {};

IntervalLineSamples[q_, sign_, t_, {lo_, hi_}] := Module[
  {poly = Expand[q], samples},
  samples = PolynomialSectorSamples[poly, t, {lo, hi}];
  Select[samples, TrueQ[sign (poly /. t -> #) > 0] &]
];
IntervalLineSamples[___] := {};
NearestIntervalLineSamples[q_, sign_, t_, domain_] := Module[
  {samples = IntervalLineSamples[q, sign, t, domain]},
  If[samples === {}, {}, MinimalBy[samples, Abs]]
];

(* Audit-only production-ready helper. No file in the distributed solver is
   modified by loading this file. Input coefficients and assignment values are
   exact; no N, floating-point normalization or angular tolerance is used.
   This preserves the original source's Union ordering and first surviving
   representative of each one-dimensional span. *)
DirectionVectorsFromRandom[p_List, v_List, a_Association, randomVectors_List] :=
 Module[{gradients, current, directions, n=Length[v], positions, pivot},
  If[n==0,Return[{}]];
  gradients=Table[(D[p[[i]],#]& /@ v)/.Normal[a],{i,Length[p]}];
  current=Lookup[a,v];
  directions=Union[gradients,{current},
    randomVectors];
  directions=Select[directions,!And@@(TrueQ[#==0]& /@ #)&];
  positions=Select[Range[Length[directions]],Function[k,
    pivot=SelectFirst[Range[n],!TrueQ[directions[[k,#]]==0]&];
    AnyTrue[Take[directions,k-1],
      TrueQ[(#[[pivot]]/directions[[k,pivot]]) directions[[k]] == #]&]]];
  Delete[directions,List /@ positions]
 ];

SourceDirectionVectors[p_List, v_List, a_Association, randomCount_Integer:10] :=
  DirectionVectorsFromRandom[p, v, a, Table[RandomInteger[{-1000,1000},Length[v]],{randomCount}]];
SourceDirectionFamily[p_List, v_List, a_Association, randomCount_Integer] := Module[{random},
  random = Table[RandomInteger[{-1000,1000},Length[v]],{randomCount}];
  <|"all" -> DirectionVectorsFromRandom[p, v, a, random], "random" -> random|>
];

End[];
EndPackage[];


BeginPackage["HELMSLocal`"];
FormulaOf::usage = "Exact CNF with atom {i,s} meaning s*polynomials[[i]]>0.";
ModelQ::usage = "Check a complete exact assignment against the original input.";
Begin["`Private`"];

FormulaOf[p_List, c_List] := And @@ (Or @@ ((#[[2]] p[[#[[1]]]] > 0) & /@ #) & /@ c);
ModelQ[p_List, c_List, v_List, a_Association] := Block[{$MaxExtraPrecision = Infinity},
  And[And @@ (KeyExistsQ[a, #] & /@ v),
    And @@ (FreeQ[#, _Real] && TrueQ[Element[#, Reals]] & /@ Lookup[a, v]),
    TrueQ[FormulaOf[p, c] /. Normal[a]]]];
ModelQ[___] := False;
CompleteAssignmentQ[v_List, a_] := AssociationQ[a] && And @@ (KeyExistsQ[a, #] & /@ v);
PairToSigned[c_List] := (#[[1]] #[[2]] & /@ #) & /@ c;

(* Both caches are scoped to ONE SolveProblem invocation. Their keys include
   the complete exact restricted problem; a hit never changes tie-breaking. *)
$RootCache = <||>; $PlaneCache = <||>;
$CacheEnabled = True; $CacheLimit = 20000;
$EngineeringEnabled = True;
$SearchContext = None; $SearchValueCache = <||>;
$SearchLastKey = Missing["NoAssignment"]; $SearchLastData = None;
$LastLocal = <||>;
$LocalIntervals = None;
$LocalBounds = {};
$CandidateSeconds = Infinity; $CandidateTimeouts = 0;
$LocalTracePath = None; $TraceRound = 0; $TraceJumps = 0; $TraceStage = "initialization";
$LocalDeadline = Infinity; $RoundDeadline = Infinity;
$LocalDeadlineTag = None; $RoundDeadlineTag = None;
DeadlineRemaining[deadline_] := If[deadline === Infinity, Infinity,
  Max[0, deadline - SessionTime[]]];
CheckLocalDeadline[] := (
  If[DeadlineRemaining[$LocalDeadline] <= 0, Throw["local-budget-exhausted", $LocalDeadlineTag]];
  If[DeadlineRemaining[$RoundDeadline] <= 0, Throw["round-budget-exhausted", $RoundDeadlineTag]]);
TraceLocal[event_String, fields_Association: <||>] := If[StringQ[$LocalTracePath],
  Module[{stream},
    stream = Quiet[Check[OpenAppend[$LocalTracePath, CharacterEncoding -> "UTF-8"], $Failed]];
    If[Head[stream] === OutputStream,
      WriteString[stream, ExportString[Join[<|"event" -> event,
        "session_seconds" -> SessionTime[], "round" -> $TraceRound,
        "num_jumps" -> $TraceJumps, "stage" -> $TraceStage|>, fields], "RawJSON"], "\n"];
      Close[stream]]], Null];
RationalAssignmentBits[a_Association] := Max[0, Sequence @@ Map[
  If[IntegerQ[#] || Head[#] === Rational,
    Max[IntegerLength[Abs[Numerator[#]], 2], IntegerLength[Denominator[#], 2]], 0] &,
  Values[a]]];
SetAttributes[BoundedCandidate, HoldAll];
BoundedCandidate[expression_, fallback_, kind_String: "candidate"] := Module[
  {value, localRemaining, roundRemaining, cap, capKind,
   timedOut = Unique["candidateTimedOut$"]},
  CheckLocalDeadline[];
  localRemaining = DeadlineRemaining[$LocalDeadline];
  roundRemaining = DeadlineRemaining[$RoundDeadline];
  cap = Min[$CandidateSeconds, localRemaining, roundRemaining];
  capKind = Which[localRemaining <= Min[$CandidateSeconds, roundRemaining], "local",
    roundRemaining <= $CandidateSeconds, "round", True, "candidate"];
  TraceLocal["candidate_started", <|"kind" -> kind|>];
  value = If[cap === Infinity,
    expression, TimeConstrained[expression, cap, timedOut]];
  (* Do not Throw from a native TimeConstrained fallback. Handle its marker
     after the timed evaluation has unwound, then apply the explicit deadline. *)
  If[value === timedOut,
    Switch[capKind,
      "local", Throw["local-budget-exhausted", $LocalDeadlineTag],
      "round", Throw["round-budget-exhausted", $RoundDeadlineTag],
      _, $CandidateTimeouts++; TraceLocal["candidate_budget_exhausted", <|"kind" -> kind|>];
        value = fallback]];
  CheckLocalDeadline[];
  TraceLocal["candidate_finished", <|"kind" -> kind|>]; value];
PutRoot[key_, value_] := If[$CacheEnabled && Length[$RootCache] < $CacheLimit,
  AssociateTo[$RootCache, key -> value]];
PutPlane[key_, value_] := If[$CacheEnabled && Length[$PlaneCache] < $CacheLimit,
  AssociateTo[$PlaneCache, key -> value]];

(* A context belongs to ONE LocalSearch call, including its own residual CNF.
   Function performs exact symbolic substitution; no numeric compilation or
   approximation is used. Clause losses contain no dynamic weights. *)
PrepareSearchContext[p_, c_, v_, delta_] := Module[{atoms, atomIndex},
  atoms = DeleteDuplicates[Flatten[c, 1]];
  atomIndex = AssociationThread[atoms, Range[Length[atoms]]];
  <|"polynomials" -> p, "clauses" -> c, "variables" -> v, "delta" -> delta,
    "atoms" -> atoms, "clause_atom_indices" -> Map[atomIndex[#] &, c, {2}],
    "evaluator" -> Function[Evaluate[v], Evaluate[p]]|>
];

SetAttributes[WithSearchContext, HoldAll];
WithSearchContext[p_, c_, v_, delta_, body_] := Block[
  {$SearchContext = None, $SearchValueCache = <||>,
    $SearchLastKey = Missing["NoAssignment"], $SearchLastData = None},
  If[TrueQ[$EngineeringEnabled], $SearchContext = PrepareSearchContext[p, c, v, delta]];
  body
];

SearchData[p_, c_, a_Association, delta_: Automatic] := Module[
  {coordinates, values, atoms, truth, atomLoss, clauseLoss, data},
  If[! TrueQ[$EngineeringEnabled] || ! AssociationQ[$SearchContext] ||
      p =!= $SearchContext["polynomials"] || c =!= $SearchContext["clauses"] ||
      (delta =!= Automatic && delta =!= $SearchContext["delta"]) ||
      ! CompleteAssignmentQ[$SearchContext["variables"], a], Return[None]];
  coordinates = Lookup[a, $SearchContext["variables"]];
  If[coordinates === $SearchLastKey, Return[$SearchLastData]];
  If[$CacheEnabled && KeyExistsQ[$SearchValueCache, coordinates],
    $SearchLastKey = coordinates; $SearchLastData = $SearchValueCache[coordinates];
    Return[$SearchLastData]];
  values = $SearchContext["evaluator"] @@ coordinates;
  atoms = $SearchContext["atoms"];
  truth = (TrueQ[#[[2]] values[[#[[1]]]] > 0] &) /@ atoms;
  atomLoss = MapThread[If[#1, 0, Abs[#2] + $SearchContext["delta"]] &,
    {truth, values[[First /@ atoms]]}];
  clauseLoss = (Min[atomLoss[[#]]] &) /@ $SearchContext["clause_atom_indices"];
  data = <|"values" -> values, "false_atoms" -> Pick[atoms, truth, False],
    "clause_losses" -> clauseLoss,
    "satisfied" -> ((Or @@ truth[[#]]) & /@ $SearchContext["clause_atom_indices"])|>;
  $SearchLastKey = coordinates; $SearchLastData = data;
  If[$CacheEnabled && Length[$SearchValueCache] < $CacheLimit,
    AssociateTo[$SearchValueCache, coordinates -> data]];
  data
];
SearchData[___] := None;

ExactPolynomialValues[p_, a_] := Module[{data = None},
  If[AssociationQ[$SearchContext], data = SearchData[p, $SearchContext["clauses"], a]];
  If[AssociationQ[data], data["values"], p /. Normal[a]]
];

LocalModelQ[p_, c_, v_, a_] := Module[{data = SearchData[p, c, a]},
  If[AssociationQ[data] && v === $SearchContext["variables"],
    And @@ data["satisfied"], ModelQ[p, c, v, a]]
];

Loss[p_, c_, a_, w_, delta_] := Module[{data = SearchData[p, c, a, delta], values},
  If[AssociationQ[data], Return[Total[w data["clause_losses"]]]];
  values = p /. Normal[a];
  Total[MapThread[#2 Min[(If[TrueQ[#[[2]] values[[#[[1]]]] > 0],
    0, Abs[values[[#[[1]]]]] + delta] & /@ #1)] &, {c, w}]]];
FalseAtoms[p_, c_, a_] := Module[{data = SearchData[p, c, a], values},
  If[AssociationQ[data], Return[data["false_atoms"]]];
  values = p /. Normal[a];
  Select[DeleteDuplicates[Flatten[c, 1]], ! TrueQ[#[[2]] values[[#[[1]]]] > 0] &]];

SatisfiedClauseCount[p_, c_, a_] := Module[{data = SearchData[p, c, a], values},
  If[AssociationQ[data], Return[Count[data["satisfied"], True]]];
  values = p /. Normal[a];
  Count[(Or @@ (TrueQ[#[[2]] values[[#[[1]]]] > 0] & /@ #) &) /@ c, True]
];

(* Every bound is a necessary open constraint of the original local CNF.
   No bound is extracted from a disjunction. Bounds do not establish SAT. *)
BoundPolynomials[v_, intervals_] := Flatten[Table[
  Join[If[intervals[x][[1]] === -Infinity, {}, {x - intervals[x][[1]]}],
    If[intervals[x][[2]] === Infinity, {}, {intervals[x][[2]] - x}]], {x, v}]];
InLocalBoundsQ[v_, a_] := ! AssociationQ[$LocalIntervals] ||
  And @@ (TrueQ[$LocalIntervals[#][[1]] < a[#] < $LocalIntervals[#][[2]]] & /@ v);
LineDomain[v_, a_, d_] := If[AssociationQ[$LocalIntervals],
  HELMSLocalSupport`LineParameterInterval[v, a, d, $LocalIntervals], {-Infinity, Infinity}];
LineGoodSamples[q_, sign_, t_, domain_] := BoundedCandidate[If[domain === {-Infinity, Infinity},
  Select[RootSamples[q, t], TrueQ[sign (q /. t -> #) > 0] &],
  HELMSLocalSupport`IntervalLineSamples[q, sign, t, domain]], {}, "line"];

RootSamples[q_, t_] := Module[{poly = Expand[q], key, samples},
  key = {poly /. t -> HoldComplete[PaperUnivariate], "primitive-rational-sector-samples-v3",
    HELMSLocalSupport`$SectorSamplePolicy};
  If[$CacheEnabled && KeyExistsQ[$RootCache, key], Return[$RootCache[key]]];
  If[FreeQ[poly, t], Return[{}]];
  samples = HELMSLocalSupport`PolynomialSectorSamples[poly, t];
  PutRoot[key, samples]; samples
];

BestCandidate[p_, c_, v_, a_, w_, delta_, candidates_List] := Module[
  {valid, before, losses, best, positions},
  valid = DeleteDuplicates[Select[candidates, CompleteAssignmentQ[v, #] && InLocalBoundsQ[v, #] &]];
  If[valid === {}, Return[Missing["NoImprovement"]]];
  before = Loss[p, c, a, w, delta];
  losses = Loss[p, c, #, w, delta] & /@ valid;
  best = Min[losses];
  If[! TrueQ[before > best], Return[Missing["NoImprovement"]]];
  positions = Flatten[Position[losses, x_ /; TrueQ[x == best], {1}]];
  If[positions === {}, Return[Missing["NoImprovement"]]];
  valid[[RandomChoice[positions]]]
];

PlainLineCandidates[p_, atoms_, v_, a_, directions_List] := Module[
  {t, candidates = {}, restricted, good, nearest, candidate, domain},
  t = Unique["line$"];
  Do[
    domain = LineDomain[v, a, d]; If[MissingQ[domain], Continue[]];
    restricted = Expand[p /. Thread[v -> (Lookup[a, v] + t d)]];
    Do[
      good = LineGoodSamples[restricted[[atom[[1]]]], atom[[2]], t, domain];
      If[good =!= {},
        nearest = MinimalBy[good, Abs];
        candidate = Association[Thread[v -> (Lookup[a, v] + RandomChoice[nearest] d)]];
        AppendTo[candidates, candidate]],
      {atom, atoms}], {d, directions}];
  candidates
];

AtomWitness[q_, sign_, tvars_List, extra_List: {}] := Module[
  {key, ans, conditions, constantConditions, cnf},
  conditions = DeleteDuplicates[Expand /@ Prepend[extra, sign q]];
  constantConditions = Select[conditions, FreeQ[#, Alternatives @@ tvars] &];
  If[AnyTrue[constantConditions, TrueQ[# <= 0] &], Return[<|"status" -> "unsat"|>]];
  conditions = Select[conditions, ! TrueQ[# > 0] &];
  key = {conditions, tvars, "unit-bound-constrained-atom"};
  If[$CacheEnabled && KeyExistsQ[$PlaneCache, key], Return[$PlaneCache[key]]];
  cnf = List /@ Range[Length[conditions]];
  ans = BoundedCandidate[HELMSMCSAT`MCSATSolver[cnf, conditions, tvars],
    {"candidate-budget-exhausted"}, "plane"];
  If[MatchQ[ans, {"sat", _, _Association}] &&
      CompleteAssignmentQ[tvars, ans[[3]]] &&
      And @@ (TrueQ[(# /. Normal[ans[[3]]]) > 0] & /@ conditions),
    ans = <|"status" -> "sat", "assignment" -> ans[[3]]|>,
    ans = If[MatchQ[ans, {"unsat", ___}], <|"status" -> "unsat"|>, <|"status" -> "unknown"|>]];
  If[ans["status"] =!= "unknown", PutPlane[key, ans]];
  ans
];

(* A separate SAT-only check of the complete residual CNF, restoring a
   capability present in the original ELS0 implementation.  Only the chosen
   coordinates are free. UNSAT of this restriction is not global UNSAT.
   BoundedCandidate includes both the solve and exact full-formula check. *)
FullResidualPlaneCheck[p_, c_, v_, a_, indices_List] := BoundedCandidate[
  Module[{pair = v[[indices]], fixed, restricted, answer, candidate},
    fixed = KeyDrop[a, pair];
    restricted = Expand[p /. Normal[fixed]];
    answer = HELMSMCSAT`MCSATSolver[PairToSigned[c], restricted, pair];
    If[MatchQ[answer, {"unsat", ___}],
      Return[<|"status" -> "restricted-unsat"|>]];
    If[! MatchQ[answer, {"sat", _, _Association}] ||
        ! CompleteAssignmentQ[pair, answer[[3]]],
      Return[<|"status" -> "unknown", "reason" -> "no complete plane witness"|>]];
    candidate = Join[a, KeyTake[answer[[3]], pair]];
    If[ModelQ[p, c, v, candidate],
      <|"status" -> "sat", "assignment" -> candidate|>,
      <|"status" -> "unknown", "reason" -> "full original model check failed"|>]],
  <|"status" -> "unknown", "reason" -> "candidate budget exhausted"|>,
  "full-residual-coordinate-plane"];

PlainPlaneCandidates[p_, atoms_, v_, a_, planes_List] := Module[
  {t1, t2, restricted, candidates = {}, witness, point},
  t1 = Unique["plane$"]; t2 = Unique["plane$"];
  Do[
    If[TrueQ[MatrixRank[basis] == 2],
      restricted = Expand[p /. Thread[v -> (Lookup[a, v] + t1 basis[[1]] + t2 basis[[2]])]];
      Do[
        witness = AtomWitness[restricted[[atom[[1]]]], atom[[2]], {t1, t2},
          Expand[$LocalBounds /. Thread[v -> (Lookup[a, v] + t1 basis[[1]] + t2 basis[[2]])]]];
        If[witness["status"] === "sat",
          point = Lookup[a, v] + witness["assignment"][t1] basis[[1]] +
            witness["assignment"][t2] basis[[2]];
          AppendTo[candidates, Association[Thread[v -> point]]]],
        {atom, atoms}]], {basis, planes}];
  candidates
];

PlainAxesPlaneCandidates[p_, atoms_, v_, a_] := Module[
  {candidates = {}, partial, restricted, witness, pair},
  Do[
    pair = v[[indices]];
    partial = KeyDrop[a, pair];
    (* Use the two absolute coordinates, as in Section 3.1. Their current
       values are neither substituted into the atom nor used as solver seeds. *)
    restricted = Expand[p /. Normal[partial]];
    Do[
      witness = AtomWitness[restricted[[atom[[1]]]], atom[[2]], pair, Expand[$LocalBounds /. Normal[partial]]];
      If[witness["status"] === "sat",
        AppendTo[candidates, Join[a, witness["assignment"]]]],
      {atom, atoms}], {indices, Subsets[Range[Length[v]], {2}]}];
  candidates
];

(* Restrict just the polynomials referenced by the same ordered false atoms.
   Reap/Sow collects candidates in the original direction/atom iteration order.
   RandomChoice is still invoked once at each original call site. *)
RestrictPolynomials[p_, indices_List, rules_List, expand_: True] := Module[
  {restricted = p[[indices]] /. rules},
  AssociationThread[indices, If[TrueQ[expand], Expand[restricted], restricted]]
];

LineCandidates[p_, atoms_, v_, a_, directions_List] := If[! TrueQ[$EngineeringEnabled],
  PlainLineCandidates[p, atoms, v, a, directions], Module[
    {t, current, active, restricted, q, good, nearest, candidate, domain},
    t = Unique["line$"]; current = Lookup[a, v];
    active = DeleteDuplicates[First /@ atoms];
    Flatten[Reap[Do[
      domain = LineDomain[v, a, d]; If[MissingQ[domain], Continue[]];
      restricted = RestrictPolynomials[p, active, Thread[v -> (current + t d)]];
      Do[
        q = restricted[atom[[1]]]; good = LineGoodSamples[q, atom[[2]], t, domain];
        If[good =!= {}, nearest = MinimalBy[good, Abs];
          candidate = Association[Thread[v -> (current + RandomChoice[nearest] d)]];
          Sow[candidate, CandidateOutput]], {atom, atoms}], {d, directions}],
      CandidateOutput][[2]], 1]
  ]
];

PlaneCandidates[p_, atoms_, v_, a_, planes_List] := If[! TrueQ[$EngineeringEnabled],
  PlainPlaneCandidates[p, atoms, v, a, planes], Module[
    {t1, t2, current, active, restricted, witness, point},
    t1 = Unique["plane$"]; t2 = Unique["plane$"];
    current = Lookup[a, v]; active = DeleteDuplicates[First /@ atoms];
    Flatten[Reap[Do[
      If[TrueQ[MatrixRank[basis] == 2],
        restricted = RestrictPolynomials[p, active,
          Thread[v -> (current + t1 basis[[1]] + t2 basis[[2]])]];
        Do[
          witness = AtomWitness[restricted[atom[[1]]], atom[[2]], {t1, t2},
            Expand[$LocalBounds /. Thread[v -> (current + t1 basis[[1]] + t2 basis[[2]])]]];
          If[witness["status"] === "sat",
            point = current + witness["assignment"][t1] basis[[1]] +
              witness["assignment"][t2] basis[[2]];
            Sow[Association[Thread[v -> point]], CandidateOutput]], {atom, atoms}]],
      {basis, planes}], CandidateOutput][[2]], 1]
  ]
];

AxesPlaneCandidates[p_, atoms_, v_, a_] := If[! TrueQ[$EngineeringEnabled],
  PlainAxesPlaneCandidates[p, atoms, v, a], Module[
    {active, partial, restricted, witness, pair},
    active = DeleteDuplicates[First /@ atoms];
    Flatten[Reap[Do[
      pair = v[[indices]]; partial = KeyDrop[a, pair];
      restricted = RestrictPolynomials[p, active, Normal[partial]];
      Do[
        witness = AtomWitness[restricted[atom[[1]]], atom[[2]], pair, Expand[$LocalBounds /. Normal[partial]]];
        If[witness["status"] === "sat",
          Sow[Join[a, witness["assignment"]], CandidateOutput]], {atom, atoms}],
      {indices, Subsets[Range[Length[v]], {2}]}], CandidateOutput][[2]], 1]
  ]
];

Reweight[p_, c_, a_, w_, probability_] := Module[{data = SearchData[p, c, a], values, satisfied},
  satisfied = If[AssociationQ[data], data["satisfied"],
    values = p /. Normal[a];
    (Or @@ (TrueQ[#[[2]] values[[#[[1]]]] > 0] & /@ #) &) /@ c];
  If[RandomReal[] >= probability,
    MapThread[If[#2, #1, #1 + 1] &, {w, satisfied}],
    MapThread[If[#2 && #1 > 1, #1 - 1, #1] &, {w, satisfied}]]
];

LocalSearch[p_, c_, v_, restarts_Integer, maxJumps_Integer, twoD_, cfg_Association,
    budget_: Infinity] := Block[{$SearchContext = None, $SearchValueCache = <||>,
      $SearchLastKey = Missing["NoAssignment"], $SearchLastData = None,
      $LocalIntervals = None, $LocalBounds = {},
      $CandidateSeconds = Lookup[cfg, "local_candidate_seconds", 2], $CandidateTimeouts = 0,
      $LocalTracePath = Lookup[cfg, "local_trace_path", None], $TraceRound = 0, $TraceJumps = 0,
      $TraceStage = "initialization", $LocalDeadline = Infinity, $RoundDeadline = Infinity,
      $LocalDeadlineTag = Unique["localDeadline$"], $RoundDeadlineTag = Unique["roundDeadline$"],
      HELMSLocalSupport`$SectorSamplePolicy = "near-origin"},
  Module[{a, w, atoms, directions, axes, planes,
    candidate, result, jumps = 0, n = Length[v], count, oneRun, oneRound, delta, probability,
    foundTag = Unique["localModel$"], preprocessing, directionFamily, attempted = 0,
    totalBudget, requestBudget, configuredBudget, roundBudget, roundTimeouts = 0,
    experimentDeadline, experimentRemaining, wholeExperimentBudget,
    totalBudgetExhausted = False, experimentBudgetExhausted = False, cycleRestarts = 0,
    assignmentBitLimit = Lookup[cfg, "local_assignment_bit_limit", 4096],
    assignmentBits = 0, maximumAssignmentBits = 0, complexityRestarts = 0,
    stagnationLimit = Lookup[cfg, "local_stagnation_jump_limit", 64],
    bestSatisfied = 0, currentSatisfied = 0, maximumSatisfied = 0,
    jumpsWithoutClauseImprovement = 0, stagnationRestarts = 0,
    sectorPolicy = Lookup[cfg, "local_sector_policy", "alternating"],
    effectiveRoundBudget, roundCapKind, roundTimedOut = Unique["roundTimedOut$"],
    fullPlaneCheck = TrueQ[twoD] && TrueQ[Lookup[cfg, "local_full_plane_check", False]],
    fullPlanePairs, fullPlaneIndices, fullPlaneResult,
    fullPlaneChecks = 0, fullPlaneRestrictedUnsat = 0, fullPlaneUnknown = 0,
    fullPlaneModels = 0,
    visited, cycleState, cycleKey, roundResult},
  delta = Lookup[cfg, "l2o_delta", 1];
  probability = Lookup[cfg, "weight_decrease_probability", 0.003];
  count = Lookup[cfg, "random_direction_count", 6];
  requestBudget = Lookup[cfg, "experiment_timeout_seconds", Infinity];
  If[! TrueQ[requestBudget === Infinity || (NumberQ[requestBudget] && requestBudget > 0)],
    requestBudget = Infinity];
  experimentDeadline = Lookup[cfg, "experiment_deadline_session_seconds",
    If[requestBudget === Infinity, Infinity, SessionTime[] + requestBudget]];
  experimentRemaining = DeadlineRemaining[experimentDeadline];
  configuredBudget = Lookup[cfg, "local_search_seconds",
    If[requestBudget === Infinity, 1200, requestBudget]];
  If[! TrueQ[configuredBudget === Infinity || (NumberQ[configuredBudget] && configuredBudget > 0)],
    configuredBudget = If[requestBudget === Infinity, 1200, requestBudget]];
  totalBudget = Min[budget, configuredBudget, requestBudget, experimentRemaining];
  wholeExperimentBudget = experimentDeadline =!= Infinity &&
    TrueQ[totalBudget >= experimentRemaining];
  roundBudget = Lookup[cfg, "local_round_seconds", totalBudget/Max[1, restarts]];
  If[! TrueQ[$CandidateSeconds === Infinity || (NumberQ[$CandidateSeconds] && $CandidateSeconds > 0)],
    $CandidateSeconds = 2];
  If[! TrueQ[totalBudget === Infinity || (NumberQ[totalBudget] && totalBudget > 0)],
    totalBudget = 0];
  If[! TrueQ[roundBudget === Infinity || (NumberQ[roundBudget] && roundBudget > 0)],
    roundBudget = totalBudget/Max[1, restarts]];
  If[! TrueQ[assignmentBitLimit === Infinity ||
      (IntegerQ[assignmentBitLimit] && assignmentBitLimit > 0)], assignmentBitLimit = 4096];
  If[stagnationLimit === 0, stagnationLimit = Infinity];
  If[! TrueQ[stagnationLimit === Infinity ||
      (IntegerQ[stagnationLimit] && stagnationLimit > 0)], stagnationLimit = 64];
  If[! MemberQ[{"alternating", "near-origin", "interior"}, sectorPolicy], sectorPolicy = "alternating"];
  $LocalDeadline = If[totalBudget === Infinity, Infinity,
    Min[SessionTime[] + totalBudget, experimentDeadline]];
  axes = If[n == 0, {}, IdentityMatrix[n]];
  fullPlanePairs = If[fullPlaneCheck && n >= 2, Subsets[Range[n], {2}], {}];
  preprocessing = HELMSLocalSupport`UnitLinearIntervals[p, c, v];
  If[! TrueQ[preprocessing["consistent"]],
    Return[<|"status" -> "unknown", "assignment" -> AssociationThread[v, ConstantArray[0, n]],
      "num_jumps" -> 0, "restarts_attempted" -> 0,
      "reason" -> "inconsistent necessary unit bounds; local search does not report UNSAT"|>]];
  $LocalIntervals = preprocessing["intervals"];
  $LocalBounds = BoundPolynomials[v, $LocalIntervals];
  $LastLocal = <|"status" -> "unknown", "assignment" -> Association[Thread[v -> ConstantArray[0, n]]],
    "num_jumps" -> 0|>;
  oneRound[r_] := (
      $TraceRound = r;
      $TraceStage = "initialization";
      HELMSLocalSupport`$SectorSamplePolicy = If[sectorPolicy === "alternating",
        If[OddQ[r], "near-origin", "interior"], sectorPolicy];
      TraceLocal["round_started"];
      a = HELMSLocalSupport`OriginalStyleInitialAssignment[v, $LocalIntervals, r];
      w = ConstantArray[1, Length[c]];
      visited = <||>;
      bestSatisfied = SatisfiedClauseCount[p, c, a];
      maximumSatisfied = Max[maximumSatisfied, bestSatisfied];
      jumpsWithoutClauseImprovement = 0;
      $LastLocal = <|"status" -> "unknown", "assignment" -> a, "num_jumps" -> jumps|>;
      CheckLocalDeadline[];
      If[LocalModelQ[p, c, v, a], Throw[<|"status" -> "sat", "assignment" -> a,
        "num_jumps" -> jumps|>, foundTag]];
      (* One deterministic coordinate plane per restart, independent of case
         names and labels. This check is separate from target-atom cell jumps. *)
      If[fullPlanePairs =!= {},
        fullPlaneIndices = fullPlanePairs[[1 + Mod[r - 1, Length[fullPlanePairs]]]];
        fullPlaneChecks++;
        $TraceStage = "full-residual-coordinate-plane";
        TraceLocal["full_residual_plane_started", <|"plane_indices" -> fullPlaneIndices|>];
        fullPlaneResult = FullResidualPlaneCheck[p, c, v, a, fullPlaneIndices];
        TraceLocal["full_residual_plane_finished", <|"plane_indices" -> fullPlaneIndices,
          "status" -> fullPlaneResult["status"]|>];
        Switch[fullPlaneResult["status"],
          "sat", fullPlaneModels++;
            Throw[<|"status" -> "sat", "assignment" -> fullPlaneResult["assignment"],
              "num_jumps" -> jumps|>, foundTag],
          "restricted-unsat", fullPlaneRestrictedUnsat++,
          _, fullPlaneUnknown++]];
      Do[
        CheckLocalDeadline[];
        $TraceStage = "model-check";
        assignmentBits = RationalAssignmentBits[a];
        maximumAssignmentBits = Max[maximumAssignmentBits, assignmentBits];
        If[LocalModelQ[p, c, v, a], Throw[<|"status" -> "sat", "assignment" -> a,
          "num_jumps" -> jumps|>, foundTag]];
        If[c === {} || MemberQ[c, {}] || n == 0, Break[]];
        (* Strictly positive continuous-loss moves can keep approaching a
           boundary while no additional clause becomes true. Restart after a
           configurable plateau in the best unweighted clause count. This does
           not change the four-strategy priority or bypass a positive line jump. *)
        If[stagnationLimit =!= Infinity && jumpsWithoutClauseImprovement >= stagnationLimit,
          stagnationRestarts++;
          TraceLocal["clause_count_stagnation_restart", <|
            "best_satisfied_clauses" -> bestSatisfied,
            "jumps_without_clause_improvement" -> jumpsWithoutClauseImprovement|>];
          Break[]];
        If[assignmentBitLimit =!= Infinity && assignmentBits > assignmentBitLimit,
          complexityRestarts++;
          TraceLocal["assignment_complexity_restart", <|"rational_assignment_bits" -> assignmentBits|>];
          Break[]];
        (* Reweighting can make a previous assignment useful again. Only the
           complete assignment AND exact weight vector identify a repeat.
           Hash buckets retain exact states, so collisions do not end a run. *)
        cycleState = {a, w}; cycleKey = Hash[cycleState, "SHA256"];
        If[KeyExistsQ[visited, cycleKey] &&
            AnyTrue[visited[cycleKey], SameQ[#, cycleState] &],
          cycleRestarts++; TraceLocal["cycle_restart"]; Break[]];
        If[KeyExistsQ[visited, cycleKey],
          AssociateTo[visited, cycleKey -> Append[visited[cycleKey], cycleState]],
          AssociateTo[visited, cycleKey -> {cycleState}]];
        atoms = FalseAtoms[p, c, a];
        $TraceStage = "coordinate-lines"; TraceLocal["stage_started"];
        candidate = BestCandidate[p, c, v, a, w, delta, LineCandidates[p, atoms, v, a, axes]];
        TraceLocal["stage_finished"];
        If[MissingQ[candidate],
          w = Reweight[p, c, a, w, probability];
          directionFamily = HELMSLocalSupport`SourceDirectionFamily[p, v, a, count];
          directions = directionFamily["all"];
          $TraceStage = "general-lines"; TraceLocal["stage_started"];
          candidate = BestCandidate[p, c, v, a, w, delta,
            LineCandidates[p, atoms, v, a, directions]];
          TraceLocal["stage_finished"];
          If[MissingQ[candidate] && TrueQ[twoD] && n >= 2,
            w = Reweight[p, c, a, w, probability];
            $TraceStage = "coordinate-planes"; TraceLocal["stage_started"];
            candidate = BestCandidate[p, c, v, a, w, delta,
              AxesPlaneCandidates[p, atoms, v, a]];
            TraceLocal["stage_finished"];
            If[MissingQ[candidate],
              w = Reweight[p, c, a, w, probability];
              planes = Partition[directionFamily["random"], 2];
              $TraceStage = "random-planes"; TraceLocal["stage_started"];
              candidate = BestCandidate[p, c, v, a, w, delta,
                PlaneCandidates[p, atoms, v, a, planes]];
              TraceLocal["stage_finished"]]]];
        If[MissingQ[candidate], Break[]];
        a = candidate; jumps++;
        maximumAssignmentBits = Max[maximumAssignmentBits, RationalAssignmentBits[a]];
        currentSatisfied = SatisfiedClauseCount[p, c, a];
        If[currentSatisfied > bestSatisfied,
          bestSatisfied = currentSatisfied; jumpsWithoutClauseImprovement = 0,
          jumpsWithoutClauseImprovement++];
        maximumSatisfied = Max[maximumSatisfied, currentSatisfied];
        $TraceJumps = jumps;
        $LastLocal = <|"status" -> "unknown", "assignment" -> a, "num_jumps" -> jumps|>;
        If[LocalModelQ[p, c, v, a], Throw[<|"status" -> "sat", "assignment" -> a,
          "num_jumps" -> jumps|>, foundTag]], {maxJumps}];
      Null
  );
  oneRun[] := Catch[
    CheckLocalDeadline[];
    If[TrueQ[$EngineeringEnabled], $SearchContext = PrepareSearchContext[p, c, v, delta]];
    Do[
      $RoundDeadline = Infinity; CheckLocalDeadline[];
      attempted = r;
      effectiveRoundBudget = Min[roundBudget, DeadlineRemaining[$LocalDeadline]];
      roundCapKind = If[DeadlineRemaining[$LocalDeadline] <= roundBudget, "local", "round"];
      $RoundDeadline = If[effectiveRoundBudget === Infinity, Infinity,
        Min[SessionTime[] + effectiveRoundBudget, $LocalDeadline]];
      roundResult = Catch[
        If[effectiveRoundBudget === Infinity, oneRound[r],
          TimeConstrained[oneRound[r], effectiveRoundBudget, roundTimedOut]],
        $RoundDeadlineTag, Function[{value, tag},
          roundTimeouts++; TraceLocal["round_budget_exhausted"]; value]];
      If[roundResult === roundTimedOut,
        If[roundCapKind === "local", Throw["local-budget-exhausted", $LocalDeadlineTag],
          roundTimeouts++; TraceLocal["round_budget_exhausted"]]];
      $RoundDeadline = Infinity; CheckLocalDeadline[];
      TraceLocal["round_finished"],
      {r, restarts}];
    $LastLocal, foundTag
  ];
  result = Catch[
    oneRun[],
    $LocalDeadlineTag, Function[{value, tag}, totalBudgetExhausted = True;
      experimentBudgetExhausted = wholeExperimentBudget || DeadlineRemaining[experimentDeadline] <= 0;
      TraceLocal["local_budget_exhausted"]; $LastLocal]];
  If[experimentBudgetExhausted,
    result = Join[result, <|"status" -> "timeout", "stage" -> "timeout"|>]];
  Join[result, <|"restarts_attempted" -> attempted,
    "reason" -> Which[result["status"] === "sat", "", experimentBudgetExhausted,
      "experiment time budget exhausted without a model", totalBudgetExhausted,
      "local search time budget exhausted without a model",
      roundTimeouts > 0, "finite local-search rounds exhausted; some rounds reached their time budget",
      True, "finite local-search rounds exhausted without a model"],
    "solver_metadata" -> <|"local_search_revision" -> "primitive-rational-residual-plane-v5",
      "full_residual_plane_check" -> fullPlaneCheck,
      "full_residual_plane_policy" -> "one rotating coordinate pair at initialization of each search round; complete residual original CNF; SAT only after full exact model check",
      "full_residual_plane_checks" -> fullPlaneChecks,
      "full_residual_planes_unsat" -> fullPlaneRestrictedUnsat,
      "full_residual_planes_inconclusive" -> fullPlaneUnknown,
      "full_residual_plane_verified_models" -> fullPlaneModels,
      "full_residual_plane_candidate_seconds" -> If[$CandidateSeconds === Infinity, "Infinity", $CandidateSeconds],
      "standalone_restart_limit" -> restarts,
      "restarts_attempted" -> attempted,
      "local_search_seconds" -> If[totalBudget === Infinity, "Infinity", totalBudget],
      "local_round_seconds" -> If[roundBudget === Infinity, "Infinity", roundBudget],
      "local_candidate_seconds" -> If[$CandidateSeconds === Infinity, "Infinity", $CandidateSeconds],
      "experiment_timeout_seconds" -> If[requestBudget === Infinity, "Infinity", requestBudget],
      "total_local_budget_exhausted" -> totalBudgetExhausted,
      "experiment_time_budget_exhausted" -> experimentBudgetExhausted,
      "candidate_budget_exhaustions" -> $CandidateTimeouts,
      "round_budget_exhaustions" -> roundTimeouts,
      "cycle_restarts" -> cycleRestarts,
      "cycle_state" -> "complete exact assignment and clause weights",
      "local_assignment_bit_limit" -> If[assignmentBitLimit === Infinity, "Infinity", assignmentBitLimit],
      "maximum_rational_assignment_bits" -> maximumAssignmentBits,
      "assignment_complexity_restarts" -> complexityRestarts,
      "local_stagnation_jump_limit" -> If[stagnationLimit === Infinity, "Infinity", stagnationLimit],
      "clause_count_stagnation_restarts" -> stagnationRestarts,
      "maximum_satisfied_clause_count" -> maximumSatisfied,
      "stagnation_basis" -> "jumps without improving the best unweighted satisfied-clause count within a round",
      "sector_sampling_policy" -> sectorPolicy,
      "local_trace_enabled" -> StringQ[$LocalTracePath],
      "unit_bound_count" -> Length[preprocessing["used_atoms"]],
      "direction_policy" -> "source gradients/current plus configured random vectors",
      "initialization_policy" -> "strict unit-bound interior; source one/sign/rational preferences",
      "plane_policy" -> "one target-atom witness subject to necessary unit bounds; highest positive score"|>|>]
]];

OpenCADSolve[p_, c_, v_] := Module[{formula = FormulaOf[p, c], cad, instances, a},
  If[TrueQ[formula], Return[<|"status" -> "sat", "stage" -> "OpenCAD",
    "assignment" -> Association[Thread[v -> ConstantArray[0, Length[v]]]]|>]];
  If[formula === False, Return[<|"status" -> "unsat", "stage" -> "OpenCAD"|>]];
  cad = Quiet[Check[GenericCylindricalDecomposition[formula, v], $Failed]];
  If[cad === {False, False}, Return[<|"status" -> "unsat", "stage" -> "OpenCAD"|>]];
  If[! MatchQ[cad, {_, _}], Return[<|"status" -> "unknown", "stage" -> "OpenCAD",
    "reason" -> "OpenCAD did not return a decomposition"|>]];
  If[cad[[1]] === False, Return[<|"status" -> "unknown", "stage" -> "OpenCAD",
    "reason" -> "no certified full-dimensional witness"|>]];
  instances = Quiet[Check[FindInstance[cad[[1]], v, Reals, 1], {}]];
  If[MatchQ[instances, {_List ..}],
    a = Association[First[instances]];
    If[ModelQ[p, c, v, a], Return[<|"status" -> "sat", "stage" -> "OpenCAD", "assignment" -> a|>]]];
  <|"status" -> "unknown", "stage" -> "OpenCAD", "reason" -> "exact model verification failed"|>
];

FromMCSAT[raw_, stage_] := Which[
  MatchQ[raw, {"sat", _, _Association}], <|"status" -> "sat", "stage" ->
    If[MemberQ[{"mcsat-ELS", "MCSAT:local-search"}, raw[[2]]], "Stage2-2D-LS", stage], "assignment" -> raw[[3]]|>,
  MatchQ[raw, {"unsat", ___}], <|"status" -> "unsat", "stage" -> stage|>,
  True, <|"status" -> "unknown", "stage" -> stage, "reason" -> ToString[raw, InputForm]|>
];

End[];
EndPackage[];


BeginPackage["HELMSCore`"];
SolveProblem::usage = "SolveProblem[polynomials, pairCNF, variables, config] runs HELMS with its embedded exact local-search engine.";
Begin["`Private`"];

Remaining[deadline_] := If[deadline === Infinity, Infinity,
  Max[0, deadline - SessionTime[]]];
TimeoutResult[] := <|"status" -> "timeout", "stage" -> "timeout",
  "reason" -> "solve budget exhausted"|>;

SolveHybrid[p_, c_, v_, cfg_, deadline_] := Module[
  {n = Length[v], polynum = Length[p], degrees, maxdeg, mindeg, maxJump,
    stage1Seconds, initial, local, residual, rest, count = 0, stage2Start,
    threshold, after, conflict, shouldSwitch, options, raw, result,
    stage1Restarts = Lookup[cfg, "max_restart_stage1", 1],
    stage2Restarts = Lookup[cfg, "max_restart_stage2", 3],
    stage1Calls = 0, stage2Calls = 0, stage1Metadata = <||>,
    stage2Metadata = <||>, localCfg, finish, run, exitTag = Unique["helmsDeadline$"],
    stage2WatchdogEligible = False, stage2Seconds = Infinity, stage2Deadline = Infinity,
    stage2TimedOut = Unique["helmsStage2Deadline$"], handoffReason = "none"},
  (* This flag controls the complete residual-CNF check in the common
     engine, independently of standalone-specific option names. *)
  localCfg = Join[cfg, <|"local_full_plane_check" -> True,
    "experiment_deadline_session_seconds" -> deadline|>];
  finish[answer_Association] := Join[answer, <|"solver_metadata" -> Join[
    Lookup[answer, "solver_metadata", <||>],
    <|"helms_revision" -> "independent-helms-v2",
      "local_search_revision" -> "primitive-rational-residual-plane-v5",
      "local_search_engine" -> "embedded exact local search",
      "full_residual_plane_check" -> True,
      "max_restart_stage1" -> stage1Restarts,
      "max_restart_stage2" -> stage2Restarts,
      "stage1_local_search_calls" -> stage1Calls,
      "stage2_local_search_calls" -> stage2Calls,
      "stage2_unit_cnf_watchdog_eligible" -> stage2WatchdogEligible,
      "stage2_unit_cnf_watchdog_seconds" -> If[stage2Seconds === Infinity,
        "unbounded", stage2Seconds],
      "stage2_handoff_reason" -> handoffReason,
      "stage1_local_search_metadata" -> stage1Metadata,
      "stage2_last_local_search_metadata" -> stage2Metadata|>]|>];
  run[] := Catch[
    If[Remaining[deadline] <= 0, Throw[TimeoutResult[], exitTag]];
    (* Retain the degree calculation and the original conflict-based switch. *)
    degrees = If[n == 0, ConstantArray[0, Length[p]],
      (If[# === 0, 0, Max[0, Sequence @@
        (Total /@ (First /@ CoefficientRules[#, v]))]] &) /@ p];
    maxdeg = Max[0, Sequence @@ degrees];
    mindeg = If[degrees === {}, 0, Min[degrees]];
    (* A high-degree conjunction has no Boolean clause choice. Reserve access
       to the complete CAD fallback even when one MCSAT projection blocks
       the cooperative switch callback or few conflicts have been counted. *)
    stage2WatchdogEligible = AllTrue[c, Length[#] == 1 &] &&
      TrueQ[maxdeg > Lookup[cfg, "open_cad_min_degree_exclusive", 2]];
    If[stage2WatchdogEligible,
      stage2Seconds = Lookup[cfg, "open_cad_unit_cnf_stage2_seconds", 20];
      If[! TrueQ[stage2Seconds === Infinity ||
          (NumberQ[stage2Seconds] && stage2Seconds > 0)], stage2Seconds = 20]];
    maxJump = Max[1, Lookup[cfg, "max_jump_multiplier", 100000] Max[1, polynum] Max[1, n]];
    initial = AssociationThread[v, ConstantArray[0, n]];
    stage1Seconds = 2 3^(mindeg/5 - 2) + 2^(polynum/10 - 3/2) +
      2^(n/10 - 3/2) + Length[c]/50 - 1/5;
    stage1Seconds = N[Lookup[cfg, "stage1_seconds_override", stage1Seconds]];
    stage1Calls++;
    local = HELMSLocal`Private`LocalSearch[p, c, v, stage1Restarts, maxJump,
      True, localCfg, Min[stage1Seconds, Remaining[deadline]]];
    stage1Metadata = Lookup[local, "solver_metadata", <||>];
    count += local["num_jumps"];
    If[local["status"] === "sat",
      Throw[Join[local, <|"stage" -> "Stage1"|>], exitTag]];
    (* A local Stage1 budget exhaustion continues to MCSAT. Only the
       common experiment deadline may terminate the complete solve. *)
    If[Remaining[deadline] <= 0, Throw[TimeoutResult[], exitTag]];
    initial = local["assignment"];
    threshold = Lookup[cfg, "open_cad_threshold_multiplier", 0.1] Min[polynum, maxdeg] n;
    stage2Start = AbsoluteTime[];
    stage2Deadline = If[stage2Seconds === Infinity, Infinity,
      Min[deadline, SessionTime[] + stage2Seconds]];
    after = Function[{prefix, full, nextLevel, maxLevel}, Module[{level, sub, assignment},
      If[Remaining[deadline] <= 0, Throw[TimeoutResult[], exitTag]];
      level = Length[prefix];
      If[Min[2 n/5, 9 maxLevel/10] < level < n - 2,
        residual = Expand[p /. Normal[prefix]]; rest = Drop[v, level];
        stage2Calls++;
        sub = HELMSLocal`Private`LocalSearch[residual, c, rest, stage2Restarts,
          maxJump, True, localCfg, Min[Remaining[deadline], Remaining[stage2Deadline]]];
        stage2Metadata = Lookup[sub, "solver_metadata", <||>];
        count += sub["num_jumps"];
        If[Remaining[deadline] <= 0, Throw[TimeoutResult[], exitTag]];
        assignment = Join[prefix, sub["assignment"]];
        If[sub["status"] === "sat" && HELMSLocal`ModelQ[p, c, v, assignment],
          <|"status" -> "sat", "assignment" -> assignment|>,
          <|"status" -> "unknown", "assignment" -> sub["assignment"]|>],
        <|"status" -> "unknown", "assignment" -> <||>|>]
    ]];
    conflict = Function[Null, count++];
    shouldSwitch = Function[Null,
      If[Remaining[deadline] <= 0, Throw[TimeoutResult[], exitTag]];
      TrueQ[AbsoluteTime[] - stage2Start > Lookup[cfg, "open_cad_min_stage2_seconds", 20] &&
        maxdeg > Lookup[cfg, "open_cad_min_degree_exclusive", 2] && count > threshold]];
    options = <|"InitialAssignment" -> initial, "AfterAssign" -> after,
      "OnTheoryConflict" -> conflict, "ShouldSwitch" -> shouldSwitch|>;
    raw = If[stage2Deadline === Infinity,
      HELMSMCSAT`MCSATSolver[HELMSLocal`Private`PairToSigned[c], p, v, options],
      TimeConstrained[
        HELMSMCSAT`MCSATSolver[HELMSLocal`Private`PairToSigned[c], p, v, options],
        Max[0.001, Remaining[stage2Deadline]], stage2TimedOut]];
    (* A phase deadline is only a scheduling event. It proves neither SAT nor
       UNSAT; CAD receives the original full formula, not a restricted slice.
       Exhaustion of the shared solve deadline always takes precedence. *)
    If[Remaining[deadline] <= 0, Throw[TimeoutResult[], exitTag]];
    result = If[raw === stage2TimedOut || MatchQ[raw, {"switch", ___}],
      handoffReason = If[raw === stage2TimedOut,
        "unit_cnf_stage2_deadline", "conflict_progress_threshold"];
      HELMSLocal`Private`OpenCADSolve[p, c, v],
      HELMSLocal`Private`FromMCSAT[raw, "Stage2"]];
    Join[result, <|"num_fail_cells_estimate" -> count|>], exitTag];
  result = If[deadline === Infinity, run[],
    TimeConstrained[run[], Max[0.001, Remaining[deadline]], TimeoutResult[]]];
  finish[result]
];

SolveProblem[p_List, c_List, v_List, cfg_Association] := Module[
  {seconds, deadline, runCfg, result},
  seconds = Lookup[cfg, "experiment_timeout_seconds", Infinity];
  If[! TrueQ[seconds === Infinity || (NumberQ[seconds] && seconds > 0)], seconds = Infinity];
  deadline = Lookup[cfg, "experiment_deadline_session_seconds",
    If[seconds === Infinity, Infinity, SessionTime[] + seconds]];
  If[! TrueQ[deadline === Infinity || NumberQ[deadline]],
    deadline = If[seconds === Infinity, Infinity, SessionTime[] + seconds]];
  runCfg = Join[cfg, <|"experiment_timeout_seconds" -> seconds,
    "experiment_deadline_session_seconds" -> deadline|>];
  (* Embedded local-search definitions run under solve-scoped cache state. *)
  result = Block[{$MaxExtraPrecision = Infinity,
      HELMSLocal`Private`$RootCache = <||>, HELMSLocal`Private`$PlaneCache = <||>,
      HELMSLocal`Private`$CacheEnabled = Lookup[cfg, "cache_enabled", True],
      HELMSLocal`Private`$CacheLimit = Lookup[cfg, "cache_max_entries", 20000],
      HELMSLocal`Private`$EngineeringEnabled = Lookup[cfg, "engineering_optimizations", True],
      HELMSLocal`Private`$SearchContext = None},
    SolveHybrid[p, c, v, runCfg, deadline]];
  If[AssociationQ[result] && Lookup[result, "status", "error"] === "sat" &&
      ! HELMSLocal`ModelQ[p, c, v, Lookup[result, "assignment", <||>]],
    <|"status" -> "error", "stage" -> Lookup[result, "stage", "unknown"],
      "reason" -> "SAT model does not satisfy original input"|>, result]
];
End[];
EndPackage[];


(* Exact input adapters and the common calling interface. *)
BeginPackage["HELMSInput`"];
SolveEncoded::usage = "Internal input adapter for the public solver tools.";
SolveFormula::usage = "Internal strict polynomial formula adapter for the public solver tools.";
Begin["`Private`"];

$DefaultConfig = <|"max_restart_stage1" -> 1,
  "max_restart_stage2" -> 3,
  "max_jump_multiplier" -> 100000,
  "random_direction_count" -> 6,
  "open_cad_threshold_multiplier" -> 0.1,
  "open_cad_min_stage2_seconds" -> 20,
  "open_cad_min_degree_exclusive" -> 2,
  "open_cad_unit_cnf_stage2_seconds" -> 20,
  "l2o_delta" -> 1,
  "weight_decrease_probability" -> 0.003,
  "engineering_optimizations" -> True,
  "cache_enabled" -> True,
  "cache_max_entries" -> 20000,
  "require_exact_sat_model" -> True,
  "engineering_revision" -> "shared-exact-v2",
  "local_candidate_seconds" -> 2,
  "local_assignment_bit_limit" -> 4096,
  "local_stagnation_jump_limit" -> 64,
  "local_sector_policy" -> "alternating",
  "local_full_plane_check" -> True,
  "local_search_revision" -> "primitive-rational-residual-plane-v5",
  "helms_revision" -> "independent-helms-v2"|>;

InvalidInput[reason_String] := <|"status" -> "error", "stage" -> "input", "reason" -> reason|>;
VariablesQ[v_List] := DuplicateFreeQ[v] &&
  AllTrue[v, MatchQ[#, _Symbol] && ! NumericQ[#] && ! MemberQ[{True, False, Null}, #] &];
VariablesQ[_] := False;
RationalPolynomialQ[p_, v_List] := FreeQ[p, _Real] && PolynomialQ[p, v] &&
  Complement[Variables[{p}], v] === {} &&
  AllTrue[If[v === {}, {p}, Last /@ CoefficientRules[p, v]], IntegerQ[#] || Head[#] === Rational &];
EncodedQ[p_List, c_List, v_List] := VariablesQ[v] && AllTrue[p, RationalPolynomialQ[#, v] &] &&
  AllTrue[c, ListQ] && AllTrue[Flatten[c, 1],
    MatchQ[#, {_Integer, 1 | -1}] && 1 <= #[[1]] <= Length[p] &];
EncodedQ[___] := False;

ResolveConfig[overrides_, tool_: "HELMS"] :=
  If[AssociationQ[overrides], Join[$DefaultConfig, overrides], $Failed];
ValidTimeQ[seconds_] := seconds === Infinity ||
  (NumberQ[seconds] && TrueQ[0 < seconds < Infinity]);
WithinTime[seconds_, computation_Function] := If[seconds === Infinity, computation[],
  TimeConstrained[computation[], seconds,
    <|"status" -> "timeout", "stage" -> "timeout", "reason" -> "solve budget exhausted"|>]];

RunTool[p_, c_, v_, "HELMS", cfg_] := HELMSCore`SolveProblem[p, c, v, cfg];

RunEncoded[p_List, c_List, v_List, overrides_, seconds_, computation_Function, tool_: "HELMS"] := (
  If[! ValidTimeQ[seconds], Return[InvalidInput["TimeLimit must be a positive number or Infinity."]]];
  WithinTime[seconds, Function[Null, Module[{cfg},
    If[! EncodedQ[p, c, v], Return[InvalidInput[
      "Expected exact rational polynomials, distinct symbolic variables and pair-CNF atoms {index, sign}, with sign 1 or -1."]]];
    cfg = ResolveConfig[overrides, tool];
    If[! AssociationQ[cfg], Return[InvalidInput["Config must be an association and the default configuration must be available."]]];
    If[tool === "HELMS" && seconds =!= Infinity,
      cfg = Join[cfg, <|"experiment_timeout_seconds" -> seconds,
        "experiment_deadline_session_seconds" -> SessionTime[] + seconds|>]];
    computation[cfg]]]]
);

SolveEncoded[p_List, c_List, v_List, tool_String, overrides_, seconds_] :=
  RunEncoded[p, c, v, overrides, seconds, Function[config, RunTool[p, c, v, tool, config]], tool];

(* Positive Boolean formulas are converted without calling a decision procedure.
   In pair-CNF, {i,s} denotes s*polynomials[[i]]>0. No preprocessing is
   applied to callers that already provide this encoding. *)
EncodeFormula[formula_, v_List] := Module[{polynomials = {}, tag, convert, disjoin, clauses},
  tag = Unique["formulaInput$"];
  disjoin[left_, right_] := If[left === {} || right === {}, {},
    Flatten[Table[Join[a, b], {a, left}, {b, right}], 1]];
  convert[f_] := Which[
    f === True, {},
    f === False, {{}},
    Head[f] === And, Join @@ (convert /@ (List @@ f)),
    Head[f] === Or, Fold[disjoin, {{}}, convert /@ (List @@ f)],
    MemberQ[{Less, Greater}, Head[f]], Module[{terms = List @@ f, q},
      Join @@ Table[
        q = Expand[If[Head[f] === Greater,
          terms[[k]] - terms[[k + 1]], terms[[k + 1]] - terms[[k]]]];
        If[! RationalPolynomialQ[q, v], Throw[InvalidInput[
          "Inequalities must be polynomials with exact rational coefficients in the declared variables."], tag]];
        AppendTo[polynomials, q]; {{{Length[polynomials], 1}}},
        {k, Length[terms] - 1}]],
    True, Throw[InvalidInput[
      "Use strict < or > polynomial inequalities combined with And or Or. Equality, non-strict inequalities and negated constraints are unsupported."], tag]
  ];
  clauses = Catch[convert[formula], tag];
  If[AssociationQ[clauses], clauses, <|"polynomials" -> polynomials, "clauses" -> clauses|>]
];

SolveFormula[formula_, v_List, tool_String, overrides_, seconds_] := (
  If[! ValidTimeQ[seconds], Return[InvalidInput["TimeLimit must be a positive number or Infinity."]]];
  WithinTime[seconds, Function[Null, Module[{encoded},
    If[! VariablesQ[v], Return[InvalidInput["Variables must be distinct, unassigned symbols."]]];
    encoded = EncodeFormula[formula, v];
    If[KeyExistsQ[encoded, "status"], Return[encoded]];
    SolveEncoded[encoded["polynomials"], encoded["clauses"], v, tool, overrides,
      If[tool === "HELMS", seconds, Infinity]]]]]
);
End[];
EndPackage[];


HELMS`Solve::usage = "Solve[formula, variables] solves an exact rational strict polynomial formula. Solve[polynomials, pairCNF, variables] accepts pair-CNF, where {i,s} means s*polynomials[[i]]>0. Returns an association with status and an exact assignment for SAT. Options: \"Config\" -> <||>, \"TimeLimit\" -> Infinity.";
Options[HELMS`Solve] = {"Config" -> <||>, "TimeLimit" -> Infinity};
HELMS`Solve[p_List, c_List, v_List, OptionsPattern[]] :=
  HELMSInput`SolveEncoded[p, c, v, "HELMS", OptionValue["Config"], OptionValue["TimeLimit"]];
HELMS`Solve[formula_, v_List, OptionsPattern[]] :=
  HELMSInput`SolveFormula[formula, v, "HELMS", OptionValue["Config"], OptionValue["TimeLimit"]];
HELMS`Solve[___] := <|"status" -> "error", "stage" -> "input",
  "reason" -> "Use HELMS`Solve[formula, variables] or HELMS`Solve[polynomials, pairCNF, variables]."|>;

$ContextPath = HELMS`Private`$LoadingContextPath;
Remove["HELMS`Private`$LoadingContextPath"];
